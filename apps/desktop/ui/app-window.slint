    private property <bool> llm-draft-matches-saved:
        root.llm-draft-api-key == root.llm-saved-api-key
        && root.llm-draft-base-url == root.llm-saved-base-url
        && root.llm-draft-model == root.llm-saved-model;
    in property <LlmProviderConfigurationState> llm-provider-configured;
    private property <bool> llm-draft-configured: root.llm-provider == LlmProvider.sensenova ? root.llm-provider-configured.sensenova
        : root.llm-provider == LlmProvider.deepseek ? root.llm-provider-configured.deepseek
        : root.llm-provider == LlmProvider.qwen ? root.llm-provider-configured.qwen
        : root.llm-provider == LlmProvider.volcengine-ark ? root.llm-provider-configured.volcengine-ark
        : root.llm-provider == LlmProvider.openai ? root.llm-provider-configured.openai
        : root.llm-provider == LlmProvider.kimi ? root.llm-provider-configured.kimi
        : root.llm-provider == LlmProvider.gemini ? root.llm-provider-configured.gemini
        : root.llm-provider == LlmProvider.openrouter ? root.llm-provider-configured.openrouter
        : root.llm-provider == LlmProvider.zhipu-glm ? root.llm-provider-configured.zhipu-glm
        : root.llm-provider == LlmProvider.minimax ? root.llm-provider-configured.minimax
        : root.llm-provider == LlmProvider.siliconflow ? root.llm-provider-configured.siliconflow
        : root.llm-provider == LlmProvider.stepfun ? root.llm-provider-configured.stepfun
        : root.llm-provider-configured.custom;
    private property <string> llm-draft-provider-name: root.llm-provider == LlmProvider.sensenova ? "SenseNova"
        : root.llm-provider == LlmProvider.deepseek ? "DeepSeek"
        : root.llm-provider == LlmProvider.qwen ? "通义千问"
        : root.llm-provider == LlmProvider.volcengine-ark ? "火山方舟"
        : root.llm-provider == LlmProvider.openai ? "OpenAI"
        : root.llm-provider == LlmProvider.kimi ? "Kimi"
        : root.llm-provider == LlmProvider.gemini ? "Gemini"
        : root.llm-provider == LlmProvider.openrouter ? "OpenRouter"
        : root.llm-provider == LlmProvider.zhipu-glm ? "智谱 GLM"
        : root.llm-provider == LlmProvider.minimax ? "MiniMax"
        : root.llm-provider == LlmProvider.siliconflow ? @tr("models.provider.siliconflow" => "SiliconFlow")
        : root.llm-provider == LlmProvider.stepfun ? @tr("models.provider.stepfun" => "StepFun")
        : @tr("models.provider.custom-compatible" => "Custom compatible API");
