    changed current-page => {
        if root.current-page == AppPage.history {
            root.refresh-history();
        }
    }
    changed model-tab => { root.available-models = []; root.model-discovery-status = ""; root.model-discovery-error = false; }
    changed asr-provider => { root.available-models = []; root.model-discovery-status = ""; root.model-discovery-error = false; }
    changed asr-api-key => { root.asr-test-succeeded = false; root.asr-test-elapsed = ""; root.asr-test-result = ""; }
    changed asr-model => { root.asr-test-succeeded = false; root.asr-test-elapsed = ""; root.asr-test-result = ""; }
    changed custom-asr-api-key => { root.asr-test-succeeded = false; root.asr-test-elapsed = ""; root.asr-test-result = ""; root.available-models = []; root.model-discovery-loading = false; root.model-discovery-status = ""; root.model-discovery-error = false; }
    changed custom-asr-base-url => { root.asr-test-succeeded = false; root.asr-test-elapsed = ""; root.asr-test-result = ""; root.available-models = []; root.model-discovery-loading = false; root.model-discovery-status = ""; root.model-discovery-error = false; }
    changed custom-asr-model => { root.asr-test-succeeded = false; root.asr-test-elapsed = ""; root.asr-test-result = ""; }
    changed llm-provider => { root.available-models = []; root.model-discovery-status = ""; root.model-discovery-error = false; }
    changed llm-draft-api-key => { root.llm-config-dirty = !root.llm-draft-matches-saved; root.llm-draft-error = false; }
    changed llm-draft-base-url => { root.llm-config-dirty = !root.llm-draft-matches-saved; root.llm-draft-error = false; }
    changed llm-draft-model => { root.llm-config-dirty = !root.llm-draft-matches-saved; root.llm-draft-error = false; }
    if root.current-page != AppPage.settings: HorizontalLayout {
        padding: 10px;
        spacing: 20px;

        AppSidebar {
            current-page <=> root.current-page;
            storage-usage: root.storage-usage;
            manage-storage => {
                root.settings-section = SettingsSection.privacy-history;
                root.current-page = AppPage.settings;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: transparent;

            if root.current-page == AppPage.home: HomePage {
                width: parent.width;
                height: parent.height;
                authorized: root.authorized;
                authorization-status: root.authorization-status;
                microphone-authorized: root.microphone-authorized;
                microphone-status: root.microphone-status;
                asr-configured: root.asr-configured;
                asr-home-available: root.asr-home-available;
                asr-config-error: root.asr-config-error;
                asr-pending-test: root.asr-pending-test;
                asr-config-status: root.asr-config-status;
                shortcut-label: root.shortcut-label;
                shortcut-labels: root.shortcut-labels;
                shortcut-enabled: root.shortcut-enabled;
                usage-total-minutes: root.usage-total-minutes;
                usage-total-characters: root.usage-total-characters;
                usage-average-speed: root.usage-average-speed;
                usage-trend: root.usage-trend;
                usage-day-labels: root.usage-day-labels;
                usage-day-dates: root.usage-day-dates;
                usage-daily-minutes: root.usage-daily-minutes;
                usage-daily-characters: root.usage-daily-characters;
                usage-daily-speeds: root.usage-daily-speeds;
                usage-highlighted-day: root.usage-highlighted-day;
                usage-loading: root.usage-loading;
                usage-error: root.usage-error;
                refresh-usage => { root.refresh-usage(); }
                open-model-settings => { root.focus-asr-config = true; root.current-page = AppPage.models; }
                open-shortcut-settings => {
                    root.settings-section = SettingsSection.shortcuts-audio;
                    root.current-page = AppPage.settings;
                }
                open-microphone-settings => { root.open-microphone-settings(); }
                open-accessibility-settings => { root.open-accessibility-settings(); }
            }

            if root.current-page == AppPage.models: ModelsPage {
                width: parent.width;
                height: parent.height;
                focus-asr-config: root.focus-asr-config;
                asr-api-key <=> root.asr-api-key;
                asr-model <=> root.asr-model;
                asr-provider <=> root.asr-provider;
                active-asr-provider: root.active-asr-provider;
                cloud-asr-selected: root.cloud-asr-selected;
                asr-provider-cards: root.asr-provider-cards;
                macos-speech-selected: root.macos-speech-selected;
                macos-speech-status: root.macos-speech-status;
                paraformer-downloaded: root.paraformer-download-state == LocalModelDownloadState.downloaded;
                paraformer-installed-size: root.paraformer-installed-size;
                paraformer-selected: root.paraformer-selected;
                whisper-downloaded: root.whisper-download-state == LocalModelDownloadState.downloaded;
                whisper-installed-size: root.whisper-installed-size;
                whisper-selected: root.whisper-selected;
                qwen3-downloaded: root.qwen3-asr-download-state == LocalModelDownloadState.downloaded;
                qwen3-installed-size: root.qwen3-asr-installed-size;
                qwen3-selected: root.qwen3-asr-selected;
                sense-voice-downloaded: root.sense-voice-download-state == LocalModelDownloadState.downloaded;
                sense-voice-installed-size: root.sense-voice-installed-size;
                sense-voice-selected: root.sense-voice-selected;
                volcengine-asr-configured: root.volcengine-asr-configured;
                custom-asr-api-key <=> root.custom-asr-api-key;
                custom-asr-base-url <=> root.custom-asr-base-url;
                custom-asr-model <=> root.custom-asr-model;
                custom-asr-configured: root.custom-asr-configured;
                asr-configured: root.asr-configured;
                asr-config-error: root.asr-config-error;
                asr-draft-error <=> root.asr-draft-error;
                asr-config-status: root.asr-config-status;
                asr-testing <=> root.asr-testing;
                asr-pending-test <=> root.asr-pending-test;
                asr-config-dirty <=> root.asr-config-dirty;
                asr-error-field <=> root.asr-error-field;
                llm-enabled <=> root.llm-enabled;
                llm-provider <=> root.llm-provider;
                active-llm-provider: root.active-llm-provider;
                llm-provider-configured: root.llm-provider-configured;
                llm-provider-target: root.llm-provider-target;
                llm-provider-local: root.llm-provider-local;
                llm-config-status: root.llm-config-status;
                llm-config-dirty <=> root.llm-config-dirty;
                llm-testing <=> root.llm-testing;
                llm-draft-error <=> root.llm-draft-error;
                llm-confirmation-visible <=> root.llm-confirmation-visible;
                active-tab <=> root.model-tab;
                available-models <=> root.available-models;
                model-discovery-loading <=> root.model-discovery-loading;
                model-discovery-error <=> root.model-discovery-error;
                model-discovery-status <=> root.model-discovery-status;
                save-asr-config(provider, api-key, base-url, model) => { root.save-asr-config(provider, api-key, base-url, model); }
                select-asr-provider(provider) => { root.select-asr-provider(provider); }
                open-macos-speech-details => {
                    root.asr-test-succeeded = false;
                    root.asr-draft-error = false;
                    root.asr-test-elapsed = "";
                    root.asr-test-result = "";
                    root.macos-speech-modal-visible = true;
                    root.refresh-macos-speech();
                }
                open-asr-placeholder(kind) => {
                    root.asr-placeholder-kind = kind;
                    root.asr-placeholder-modal-visible = true;
                }
                cancel-asr-config => { root.cancel-asr-config(); }
                request-llm-enable => { root.request-llm-enable(); }
                set-llm-enabled(enabled, base-url) => { root.set-llm-enabled(enabled, base-url); }
                save-llm-config(provider, api-key, base-url, model) => { root.save-llm-config(provider, api-key, base-url, model); }
                select-llm-provider(provider) => { root.select-llm-provider(provider); }
                refresh-models => { root.refresh-models(); }
                request-asr-test => { root.request-asr-test(); }
                open-key-page => { root.open-current-provider-key-page(); }
                open-llm-config(provider) => {
                    root.llm-provider = provider;
                    root.prepare-llm-provider(provider);
                    root.llm-draft-error = false;
                    root.llm-modal-visible = true;
                }
                open-asr-config(original-provider) => {
                    root.focus-asr-config = false;
                    root.asr-modal-original-provider = original-provider;
                    root.asr-test-succeeded = false;
                    root.asr-test-elapsed = "";
                    root.asr-test-result = "";
                    root.asr-modal-visible = true;
                }
            }

            if root.current-page == AppPage.history: HistoryPage {
                width: parent.width;
                height: parent.height;
                groups: root.history-groups;
                status-text: root.history-status;
                undo-visible: root.history-undo-visible;
                has-more: root.history-has-more;
                locked: root.history-locked;
                loading: root.history-loading;
                load-failed: root.history-load-failed;
                dictionary-assist-enabled: root.dictionary-assist-enabled
                    && root.dictionary-assist-stored-consent-fingerprint == root.dictionary-assist-consent-fingerprint;
                dictionary-assist-available: root.history-enabled && !root.history-locked;
                dictionary-assist-provider-configured: root.dictionary-assist-provider-configured;
                retention: root.history-retention;
                refresh => { root.refresh-history(); }
                search(query) => { root.search-history(query); }
                load-more => { root.load-more-history(); }
                copy(id) => { root.copy-history(id); }
                delete-record(id) => { root.delete-history(id); }
                undo-delete => { root.undo-history-delete(); }
                retention-selected(retention) => { root.set-history-retention(retention); }
                dictionary-assist-toggled(enabled) => {
                    if enabled && root.dictionary-assist-stored-consent-fingerprint != root.dictionary-assist-consent-fingerprint {
                        root.dictionary-assist-consent-visible = true;
                    } else {
                        root.set-dictionary-assist-enabled(enabled);
                    }
                }
                dictionary-assist-setup-requested => {
                    root.model-tab = 1;
                    root.current-page = AppPage.models;
                }
                show-detail(item) => {
                    root.history-selected-item = item;
                    root.history-detail-visible = true;
                }
                show-clear-confirmation => { root.history-clear-confirmation-visible = true; }
                show-reset-confirmation => { root.history-reset-confirmation-visible = true; }
            }
            if root.current-page == AppPage.dictionary: DictionaryPage {
                width: parent.width;
                height: parent.height;
                items: root.dictionary-items;
                rows: root.dictionary-rows;
                total-count: root.dictionary-total-count;
                active-filter: root.dictionary-filter;
                status-text: root.dictionary-status;
                loading: root.dictionary-loading;
                load-failed: root.dictionary-load-failed;
                importing: root.dictionary-importing;
                development-environment: root.development-environment;
                evidence-items: root.dictionary-evidence-items;
                refresh => { root.refresh-dictionary(); }
                filter-selected(filter) => { root.filter-dictionary(filter); }
                search(query) => { root.search-dictionary(query); }
                layout-width-changed(width) => { root.set-dictionary-layout-width(width); }
                open-add => { root.open-dictionary-add(); }
                import-csv => { root.import-dictionary-csv(); }
                edit-word(id, canonical) => { root.open-dictionary-edit(id, canonical); }
                delete-word(id) => { root.delete-dictionary-word(id); }
            }

        }
    }

    if root.current-page == AppPage.settings: SettingsPage {
        width: parent.width;
        height: parent.height;
        app-version: root.app-version;
        current-section <=> root.settings-section;
        authorized: root.authorized;
        authorization-status: root.authorization-status;
        microphone-authorized: root.microphone-authorized;
        microphone-status: root.microphone-status;
        microphone-devices: root.microphone-devices;
        microphone-selection-id: root.microphone-selection-id;
        microphone-selection-label: root.microphone-selection-label;
        microphone-default-label: root.microphone-default-label;
        microphone-selection-status: root.microphone-selection-status;
        microphone-devices-loading: root.microphone-devices-loading;
        ui-language: root.ui-language;
        system-ui-language: root.system-ui-language;
        ui-language-saving: root.ui-language-saving;
        ui-language-status: root.ui-language-status;
        theme-id: root.theme-id;
        color-scheme: root.color-scheme;
        appearance-status: root.appearance-status;
        diagnostics-enabled <=> root.diagnostics-enabled;
        diagnostics-status: root.diagnostics-status;
        storage-usage: root.storage-usage;
        storage-usage-error: root.storage-usage-error;
        storage-local-models-usage: root.storage-local-models-usage;
        storage-recognition-usage: root.storage-recognition-usage;
        storage-diagnostics-usage: root.storage-diagnostics-usage;
        storage-other-usage: root.storage-other-usage;
        storage-local-models-percent: root.storage-local-models-percent;
        storage-recognition-percent: root.storage-recognition-percent;
        storage-diagnostics-percent: root.storage-diagnostics-percent;
        storage-other-percent: root.storage-other-percent;
        storage-local-models-path: root.storage-local-models-path;
        storage-recognition-path: root.storage-recognition-path;
        storage-diagnostics-path: root.storage-diagnostics-path;
        storage-other-path: root.storage-other-path;
        storage-local-models-visual-share: root.storage-local-models-visual-share;
        storage-recognition-visual-share: root.storage-recognition-visual-share;
        storage-diagnostics-visual-share: root.storage-diagnostics-visual-share;
        storage-other-visual-share: root.storage-other-visual-share;
        local-models-total-usage: root.local-models-total-usage;
        qwen3-storage-usage: root.qwen3-storage-usage;
        sense-voice-storage-usage: root.sense-voice-storage-usage;
        whisper-storage-usage: root.whisper-storage-usage;
        paraformer-storage-usage: root.paraformer-storage-usage;
        punctuation-storage-usage: root.punctuation-storage-usage;
        qwen3-model-share: root.qwen3-model-share;
        sense-voice-model-share: root.sense-voice-model-share;
        whisper-model-share: root.whisper-model-share;
        paraformer-model-share: root.paraformer-model-share;
        punctuation-model-share: root.punctuation-model-share;
        paraformer-downloaded: root.paraformer-download-state == LocalModelDownloadState.downloaded;
        paraformer-installed-size: root.paraformer-installed-size;
        paraformer-selected: root.paraformer-selected;
        paraformer-pending: root.paraformer-activation-pending;
        whisper-downloaded: root.whisper-download-state == LocalModelDownloadState.downloaded;
        whisper-installed-size: root.whisper-installed-size;
        whisper-selected: root.whisper-selected;
        whisper-pending: root.whisper-activation-pending;
        qwen3-downloaded: root.qwen3-asr-download-state == LocalModelDownloadState.downloaded;
        qwen3-installed-size: root.qwen3-asr-installed-size;
        qwen3-selected: root.qwen3-asr-selected;
        qwen3-pending: root.qwen3-asr-activation-pending;
        sense-voice-downloaded: root.sense-voice-download-state == LocalModelDownloadState.downloaded;
        sense-voice-installed-size: root.sense-voice-installed-size;
        sense-voice-selected: root.sense-voice-selected;
        sense-voice-pending: root.sense-voice-activation-pending;
        punctuation-downloaded: root.punctuation-download-state == LocalModelDownloadState.downloaded;
        punctuation-installed-size: root.punctuation-installed-size;
        punctuation-pending: root.punctuation-pending;
        diagnostics-export-status: root.diagnostics-export-status;
        diagnostics-export-detail: root.diagnostics-export-detail;
        update-status: root.update-status;
        update-version: root.update-version;
        update-detail: root.update-detail;
        automatic-update-checks <=> root.automatic-update-checks;
        automatic-update-status: root.automatic-update-status;
        feedback-sounds-enabled <=> root.feedback-sounds-enabled;
        feedback-sounds-status: root.feedback-sounds-status;
        mute-system-audio-enabled <=> root.mute-system-audio-enabled;
        mute-system-audio-status: root.mute-system-audio-status;
        copy-to-clipboard <=> root.copy-to-clipboard;
        copy-to-clipboard-status: root.copy-to-clipboard-status;
        launch-at-login <=> root.launch-at-login;
        launch-at-login-status: root.launch-at-login-status;
        show-in-dock <=> root.show-in-dock;
        show-in-dock-status: root.show-in-dock-status;
        show-dock-setting: root.show-dock-setting;
        show-accessibility-setting: root.show-accessibility-setting;
        shortcut-labels: root.shortcut-labels;
        shortcut-status: root.shortcut-status;
        shortcut-error-index: root.shortcut-error-index;
        shortcut-capturing <=> root.shortcut-capturing;
        back-to-app => { root.current-page = AppPage.home; }
        open-microphone-settings => { root.open-microphone-settings(); }
        open-accessibility-settings => { root.open-accessibility-settings(); }
        refresh-authorizations => { root.refresh-authorizations(); }
        select-microphone(id, name) => { root.select-microphone(id, name); }
        refresh-microphones => { root.refresh-microphones(); }
        set-ui-language(language) => { root.set-ui-language(language); }
        set-theme(theme) => { root.set-theme(theme); }
        set-color-scheme(scheme) => { root.set-color-scheme(scheme); }
        set-diagnostics-enabled(enabled) => { root.set-diagnostics-enabled(enabled); }
        export-diagnostics-report => { root.export-diagnostics-report(); }
        open-data-directory => { root.open-data-directory(); }
        refresh-storage-usage => { root.refresh-usage(); }
        delete-local-model(kind) => { root.request-local-model-delete(kind); }
        delete-punctuation-model => { root.request-punctuation-delete(); }
        check-for-updates => { root.check-for-updates(); }
        download-update => { root.download-update(); }
        open-release-notes => { root.open-release-notes(); }
        open-website => { root.open-website(); }
        open-feedback => { root.open-feedback(); }
        open-terms => { root.open-terms(); }
        open-privacy => { root.open-privacy(); }
        set-automatic-update-checks(enabled) => { root.set-automatic-update-checks(enabled); }
        set-feedback-sounds-enabled(enabled) => { root.set-feedback-sounds-enabled(enabled); }
        set-mute-system-audio-enabled(enabled) => { root.set-mute-system-audio-enabled(enabled); }
        set-copy-to-clipboard(enabled) => { root.set-copy-to-clipboard(enabled); }
        set-launch-at-login(enabled) => { root.set-launch-at-login(enabled); }
        set-show-in-dock(enabled) => { root.set-show-in-dock(enabled); }
        begin-shortcut-capture => { root.begin-shortcut-capture(); }
        edit-shortcut(index) => { root.edit-shortcut(index); }
        remove-shortcut(index) => { root.remove-shortcut(index); }
        rerun-onboarding => { root.rerun-onboarding(); }
    }

    if root.development-environment && root.current-page != AppPage.settings: Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: 31px;
        height: 18px;
        border-radius: 5px;
        background: AppColors.warning-soft;
        Text { text: "DEV"; color: AppColors.warning; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    if root.asr-modal-visible: AsrConfigurationModal {
        width: parent.width;
        height: parent.height;
        provider: root.asr-provider;
        volcengine-api-key <=> root.asr-api-key;
        volcengine-model <=> root.asr-model;
        custom-api-key <=> root.custom-asr-api-key;
        custom-base-url <=> root.custom-asr-base-url;
        custom-model <=> root.custom-asr-model;
        configured: root.asr-provider == AsrProvider.volcengine
            ? root.volcengine-asr-configured : root.custom-asr-configured;
        selected: root.cloud-asr-selected && root.active-asr-provider == root.asr-provider;
        selection-enabled: self.configured && !self.selected && !root.asr-config-dirty && !root.asr-testing;
        dirty: root.asr-config-dirty;
        testing: root.asr-testing;
        test-succeeded: root.asr-test-succeeded;
        test-elapsed: root.asr-test-elapsed;
        test-result: root.asr-test-result;
        draft-error: root.asr-draft-error;
        error-field: root.asr-error-field;
        status-message: root.asr-config-status;
        available-models <=> root.available-models;
        model-discovery-loading: root.model-discovery-loading;
        model-discovery-error: root.model-discovery-error;
        model-discovery-status: root.model-discovery-status;
        cancelled => {
            root.asr-modal-visible = false;
            root.cancel-asr-config();
        }
        test-and-save => {
            root.save-asr-config(
                root.asr-provider,
                root.asr-provider == AsrProvider.volcengine ? root.asr-api-key : root.custom-asr-api-key,
                root.asr-provider == AsrProvider.volcengine ? "" : root.custom-asr-base-url,
                root.asr-provider == AsrProvider.volcengine ? root.asr-model : root.custom-asr-model,
            );
        }
        test-connection => { root.request-asr-test(); }
        refresh-models => { root.refresh-models(); }
        open-key-page => { root.open-current-provider-key-page(); }
        select-provider => { root.activate-asr-provider(root.asr-provider); }
    }

    if root.macos-speech-modal-visible: MacOsSpeechModal {
        width: parent.width;
        height: parent.height;
        selected: root.macos-speech-selected;
        speech-status: root.macos-speech-status;
        microphone-status: root.macos-microphone-status;
        system-version: root.macos-system-version;
        system-supported: root.macos-system-supported;
        testing: root.asr-testing;
        test-succeeded: root.asr-test-succeeded;
        test-failed: root.asr-draft-error;
        test-elapsed: root.asr-test-elapsed;
        test-result: root.asr-test-result;
        cancelled => { root.macos-speech-modal-visible = false; }
        select-provider => { root.activate-macos-speech(); }
        authorize-speech => { root.activate-macos-speech(); }
        open-microphone-settings => { root.open-microphone-settings(); }
        open-speech-settings => { root.open-speech-recognition-settings(); }
        run-test => { root.request-macos-asr-test(); }
        refresh => { root.refresh-macos-speech(); }
    }

    if root.asr-placeholder-modal-visible && !root.local-asr-model-visible: UnavailableAsrProviderModal {
        width: parent.width;
        height: parent.height;
        kind: root.asr-placeholder-kind;
        cancelled => { root.asr-placeholder-modal-visible = false; }
    }

    if root.asr-placeholder-modal-visible && root.local-asr-model-visible: LocalAsrModelModal {
        width: parent.width;
        height: parent.height;
        kind: root.asr-placeholder-kind;
        download-state: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-download-state
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-download-state
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-download-state : root.paraformer-download-state;
        download-progress: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-download-progress
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-download-progress
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-download-progress : root.paraformer-download-progress;
        download-supported: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-download-supported
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-download-supported
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-download-supported : root.paraformer-download-supported;
        adapter-ready: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-adapter-ready
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-adapter-ready
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-adapter-ready : root.paraformer-adapter-ready;
        selected: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-selected
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-selected
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-selected : root.paraformer-selected;
        selection-pending: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-activation-pending
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-activation-pending
            : root.asr-placeholder-kind == AsrProviderCardKind.paraformer
                ? root.paraformer-activation-pending
                : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                    && root.whisper-activation-pending;
        download-size: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-download-size
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-download-size
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-download-size : root.paraformer-download-size;
        installed-size: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-installed-size
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-installed-size
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-installed-size : root.paraformer-installed-size;
        runtime-memory-live: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-runtime-memory-active
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-runtime-memory-active
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-runtime-memory-active : root.paraformer-runtime-memory-active;
        runtime-memory-usage: root.asr-placeholder-kind == AsrProviderCardKind.sense-voice-small
            ? root.sense-voice-runtime-memory-usage
            : root.asr-placeholder-kind == AsrProviderCardKind.qwen3-asr
            ? root.qwen3-asr-runtime-memory-usage
            : root.asr-placeholder-kind == AsrProviderCardKind.whisper-large-v3-turbo
                ? root.whisper-runtime-memory-usage : root.paraformer-runtime-memory-usage;
        testing: root.asr-testing;
        test-succeeded: root.asr-test-succeeded;
        test-failed: root.asr-draft-error;
        test-elapsed: root.asr-test-elapsed;
        test-result: root.asr-test-result;
        download-error: root.local-model-download-error;
        operation-error: root.local-model-operation-error;
        llm-enabled: root.llm-enabled;
        punctuation-mode: root.punctuation-mode;
        punctuation-download-state: root.punctuation-download-state;
        punctuation-download-progress: root.punctuation-download-progress;
        punctuation-download-size: root.punctuation-download-size;
        punctuation-installed-size: root.punctuation-installed-size;
        punctuation-runtime-live: root.punctuation-runtime-live;
        punctuation-runtime-memory: root.punctuation-runtime-memory;
        punctuation-pending: root.punctuation-pending;
        punctuation-error: root.punctuation-error;
        cancelled => { root.asr-placeholder-modal-visible = false; }
        download-requested(kind) => { root.request-local-model-download(kind); }
        pause-requested(kind) => { root.request-local-model-pause(kind); }
        cancel-download-requested(kind) => { root.request-local-model-cancel-download(kind); }
        delete-requested(kind) => { root.request-local-model-delete(kind); }
        select-provider(kind) => { root.request-local-model-selection(kind); }
        run-test(kind) => { root.request-local-model-test(kind); }
        refresh-runtime-memory(kind) => { root.refresh-local-model-runtime-memory(kind); }
        punctuation-mode-requested(mode) => { root.request-punctuation-mode(mode); }
        punctuation-download-requested => { root.request-punctuation-download(); }
        punctuation-delete-requested => { root.request-punctuation-delete(); }
        open-llm-settings => {
            root.asr-placeholder-modal-visible = false;
            root.model-tab = 1;
        }
    }

    HistoryDialog {
        width: parent.width;
        height: parent.height;
        detail-visible <=> root.history-detail-visible;
        clear-confirmation-visible <=> root.history-clear-confirmation-visible;
        reset-confirmation-visible <=> root.history-reset-confirmation-visible;
        dictionary-assist-consent-visible <=> root.dictionary-assist-consent-visible;
        dictionary-assist-provider-target: root.dictionary-assist-provider-target;
        selected-item: root.history-selected-item;
        copy(id) => { root.copy-history(id); }
        delete-record(id) => { root.delete-history(id); }
        clear-all => { root.clear-history(); }
        reset => { root.reset-history(); }
        confirm-dictionary-assist => { root.set-dictionary-assist-enabled(true); }
    }

    if root.dictionary-add-visible: DictionaryAddDialog {
        width: parent.width;
        height: parent.height;
        drafts: root.dictionary-drafts;
        nonempty-count: root.dictionary-draft-nonempty-count;
        saving: root.dictionary-saving;
        save-failed: root.dictionary-save-failed;
        status-text: root.dictionary-status;
        close => { root.close-dictionary-add(); }
        add-row => { root.add-dictionary-draft(); }
        update-row(index, value) => { root.update-dictionary-draft(index, value); }
        remove-row(index) => { root.remove-dictionary-draft(index); }
        save => { root.save-dictionary-drafts(); }
    }

    if root.dictionary-edit-visible: DictionaryEditDialog {
        width: parent.width;
        height: parent.height;
        entry-id: root.dictionary-edit-id;
        original-value: root.dictionary-edit-original-value;
        value <=> root.dictionary-edit-value;
        saving: root.dictionary-edit-saving;
        save-failed: root.dictionary-edit-failed;
        status-text: root.dictionary-status;
        close => { root.close-dictionary-edit(); }
        save(id, value) => { root.save-dictionary-edit(id, value); }
    }

    if root.llm-modal-visible: LlmConfigurationModal {
        width: parent.width;
        height: parent.height;
        provider <=> root.llm-provider;
        api-key <=> root.llm-draft-api-key;
        base-url <=> root.llm-draft-base-url;
        selected-model <=> root.llm-draft-model;
        configured: root.llm-draft-configured;
        llm-enabled: root.llm-enabled;
        selected: root.llm-enabled && root.llm-provider == root.active-llm-provider;
        dirty: root.llm-config-dirty;
        testing: root.llm-testing;
        draft-error: root.llm-draft-error;
        status-message: root.llm-config-status;
        available-models <=> root.available-models;
        model-discovery-loading: root.model-discovery-loading;
        model-discovery-status: root.model-discovery-status;
        cancelled => {
            root.llm-modal-visible = false;
            root.llm-provider = root.active-llm-provider;
            root.prepare-llm-provider(root.active-llm-provider);
        }
        save-and-test => {
            root.save-llm-config(
                root.llm-provider,
                root.llm-draft-api-key,
                root.llm-draft-base-url,
                root.llm-draft-model
            );
        }
        test-and-enable => { root.request-llm-enable(); }
        select-provider => { root.select-llm-provider(root.llm-provider); }
        select-model(model) => { root.select-llm-model(root.llm-provider, model); }
        refresh-models => { root.refresh-models(); }
        open-key-page => { root.open-current-provider-key-page(); }
    }

    if root.llm-confirmation-visible: ModelConsentDialog {
        width: parent.width;
        height: parent.height;
        target: root.llm-provider-target;
        provider-name: root.llm-draft-provider-name;
        cancelled => {
            root.llm-confirmation-visible = false;
            root.llm-confirmation-for-draft = false;
        }
        confirmed => {
            root.llm-confirmation-visible = false;
            if root.llm-confirmation-for-draft {
                root.llm-confirmation-for-draft = false;
                root.confirm-llm-config(
                    root.llm-provider,
                    root.llm-draft-api-key,
                    root.llm-draft-base-url,
                    root.llm-draft-model,
                    root.llm-provider-target
                );
            } else {
                root.set-llm-enabled(true, root.llm-provider-target);
            }
        }
    }

    if root.update-notification-visible: UpdateNotification {
        x: parent.width - self.width - 16px;
        y: 8px;
        version: root.update-version;
        close => { root.dismiss-update-notification(); }
        view-update => { root.download-update(); }
    }

    if root.local-model-download-failure-visible: LocalModelDownloadFailureDialog {
        width: parent.width;
        height: parent.height;
        detail: root.local-model-download-error;
        insufficient-space: root.local-model-download-space-failure;
        retry => {
            root.local-model-download-failure-visible = false;
            root.request-local-model-download(root.local-model-download-failure-kind);
        }
        later => { root.local-model-download-failure-visible = false; }
        manage-space => { root.open-data-directory(); }
    }
}
