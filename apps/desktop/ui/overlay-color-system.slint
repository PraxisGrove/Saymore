import { ThemeId } from "color-system.slint";

// Independent overlays keep stable neutral surfaces while their accents follow the app theme.
export global OverlayColors {
    in-out property <ThemeId> theme-id: ThemeId.saymore;

    out property <color> surface: #ffffff;
    out property <color> surface-subtle: #f4f4f1;
    out property <color> surface-subtle-hover: #efeeeb;
    out property <color> surface-hover: #f3f1ed;
    out property <color> surface-control: #efeee9;
    out property <color> surface-control-hover: #e5e3dd;
    out property <color> border: #e6e5e0;
    out property <color> border-strong: #dddad2;
    out property <color> shadow: #1f1f1c24;
    out property <color> shadow-strong: #1f1f1c2e;
    out property <color> notification-border: #dededa;
    out property <color> notification-shadow: #1616161a;

    out property <color> ink: #141413;
    out property <color> ink-soft: #1f1f1c;
    out property <color> text: #373734;
    out property <color> text-soft: #4d4b45;
    out property <color> text-muted: #7b7974;
    out property <color> text-muted-warm: #77746c;
    out property <color> text-muted-strong: #5f5d58;
    out property <color> on-accent: theme-id == ThemeId.lime-pulse ? #172014
        : theme-id == ThemeId.sunlit-gold ? #2a2107
        : #ffffff;
    out property <color> notification-ink: #161616;
    out property <color> notification-muted: #777774;

    out property <color> accent: theme-id == ThemeId.saymore ? #2563eb
        : theme-id == ThemeId.lime-pulse ? #b3e90c
        : theme-id == ThemeId.berry-graphite ? #d94f78
        : theme-id == ThemeId.iris-mist ? #7a5cce
        : theme-id == ThemeId.sunlit-gold ? #f8ce2e
        : #d97757;
    out property <color> accent-strong: theme-id == ThemeId.saymore ? #1d4ed8
        : theme-id == ThemeId.lime-pulse ? #a4d50b
        : theme-id == ThemeId.berry-graphite ? #b8325d
        : theme-id == ThemeId.iris-mist ? #5e43ad
        : theme-id == ThemeId.sunlit-gold ? #e9bb22
        : #c6613f;
    out property <color> accent-soft: theme-id == ThemeId.saymore ? #e8f0fe
        : theme-id == ThemeId.lime-pulse ? #ddf59a
        : theme-id == ThemeId.berry-graphite ? #f9dce6
        : theme-id == ThemeId.iris-mist ? #eee8fa
        : theme-id == ThemeId.sunlit-gold ? #fff3bd
        : #f6e6df;
    out property <color> accent-soft-alert: accent-soft;
    out property <color> info: accent-strong;
    out property <color> info-soft: accent-soft;
    out property <color> update-accent: #2563eb;
    out property <color> update-accent-hover: #1d4ed8;
    out property <color> update-accent-pressed: #1e40af;

    out property <color> recording-surface: #11110f;
    out property <color> recording-border: #454543;
    out property <color> recording-control: #353537;
    out property <color> recording-control-hover: #4a4946;
    out property <color> recording-control-pressed: #5a5956;
    out property <color> recording-divider: #3d3d3f;
    out property <color> recording-spinner-track: #606064;
    out property <color> recording-text: #faf9f5;
    out property <color> recording-text-warm: #faf9f8;
    out property <color> recording-icon: #d1cfc5;
    out property <color> recording-muted: #a7a7a2;
    out property <color> recording-accent: accent;
    out property <color> recording-wave-accent: accent;
    out property <color> recording-control-light: #faf9f5;
    out property <color> recording-control-light-hover: #ffffff;
    out property <color> recording-control-light-pressed: #deddd8;
    out property <color> recording-warning: #c98200;
    out property <color> recording-hover: #ffffff1a;
    out property <color> recording-pressed: #ffffff33;
    out property <brush> recording-spinner-arc: @conic-gradient(
        from 0deg,
        recording-accent 0deg,
        recording-accent 105deg,
        recording-accent.transparentize(1) 105deg,
        recording-accent.transparentize(1) 360deg
    );
}
