import {
    AsrConfigurationField,
    AsrProvider,
    AsrProviderCardKind,
    AsrProviderCardSpec,
    LlmProvider,
    LlmProviderConfigurationState,
    ModalShell,
    ModalSize,
    SystemSpeechStatus,
} from "../components.slint";
import { AppColors } from "../color-system.slint";
import { ScrollView } from "std-widgets.slint";
import { SpeechRecognitionPage } from "speech-recognition.slint";
import { TextPolishingPage } from "llm-provider-components.slint";

component ModelTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();
    width: max(56px, tab-label.preferred-width);
    height: 32px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    tab-label := Text {
        y: 0px;
        text: root.label;
        color: root.selected ? AppColors.ink : AppColors.text-muted;
        font-size: 14px;
        font-weight: root.selected ? 700 : 600;
    }
    if root.selected: Rectangle {
        y: 28px;
        width: parent.width;
        height: 3px;
        border-radius: 2px;
        background: AppColors.brand;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component ModelActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> completed: false;
    callback activated();
    width: 110px;
    height: 40px;
    border-radius: 8px;
    background: !root.enabled ? (root.completed ? AppColors.success-soft : AppColors.surface-muted)
        : root.primary ? (action-touch.has-hover ? AppColors.brand-hover : AppColors.brand)
        : action-touch.pressed ? AppColors.chart-neutral
        : action-touch.has-hover ? AppColors.selected : AppColors.surface-subtle;
    opacity: !root.enabled ? (root.completed ? 1 : 0.55) : action-touch.pressed ? 0.84 : 1;
    animate background { duration: 100ms; easing: ease-out; }
    animate opacity { duration: 70ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Text {
        text: root.label;
        color: !root.enabled ? (root.completed ? AppColors.success : AppColors.text-muted) : root.primary ? AppColors.on-brand : AppColors.text;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    action-touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.activated(); } }
}

export component ModelConsentDialog inherits Rectangle {
    in property <string> target;
    in property <string> provider-name;
    in-out property <bool> consent-checked;
    callback cancelled();
    callback confirmed();

    consent-shell := ModalShell {
        width: parent.width;
        height: parent.height;
        size: ModalSize.standard;
        close-requested => { root.cancelled(); }

        Rectangle { x: 24px; y: 22px; width: 38px; height: 38px; border-radius: 10px; background: AppColors.brand-soft; Image { x: 9px; y: 9px; width: 20px; height: 20px; source: @image-url("../../icons/lucide/sparkles.svg"); colorize: AppColors.brand; } }
        Text { x: 76px; y: 18px; width: consent-shell.panel-width - 136px; text: @tr("models.polishing.consent.title" => "Confirm sending to {}", root.provider-name); color: AppColors.ink; font-size: 18px; font-weight: 700; overflow: elide; }
        Text { x: 76px; y: 45px; width: consent-shell.panel-width - 136px; text: @tr("models.polishing.consent.intro" => "Review what will be sent before testing the connection."); color: AppColors.text-muted; font-size: 10px; overflow: elide; }

        body-scroll := ScrollView {
            x: 24px;
            y: 86px;
            width: consent-shell.panel-width - 48px;
            height: 302px;
            viewport-width: self.width;
            viewport-height: max(self.height, body.preferred-height);
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            body := Rectangle {
                width: body-scroll.viewport-width;
                min-height: 238px;
                background: transparent;

                Text { x: 0px; y: 0px; width: parent.width; text: @tr("models.polishing.consent.sent-content" => "Saymore sends the current transcript for polishing and may send confirmed dictionary terms or a short local correction fragment. When Word finder is enabled, recent final history text is also sent to this provider."); color: AppColors.text; font-size: 12px; wrap: word-wrap; }
                Rectangle {
                    x: 0px; y: 42px; width: parent.width; height: 64px; border-radius: 8px; background: AppColors.sidebar;
                    Text { x: 16px; y: 10px; text: @tr("models.polishing.consent.destination" => "Data destination"); color: AppColors.text-muted; font-size: 9px; font-weight: 600; }
                    Text { x: 16px; y: 31px; width: parent.width - 32px; text: root.target; color: AppColors.text; font-size: 11px; font-weight: 600; overflow: elide; }
                }
                Text { x: 0px; y: 124px; width: parent.width; text: @tr("models.polishing.consent.dictionary-excluded" => "Confirmed dictionary entries and complete input fields are not sent."); color: AppColors.text-muted; font-size: 10px; wrap: word-wrap; }
                Rectangle {
                    y: 154px; width: parent.width; height: 56px; border-radius: 8px; border-width: 1px; border-color: root.consent-checked ? AppColors.brand : AppColors.border; background: root.consent-checked ? AppColors.brand-soft : AppColors.surface;
                    accessible-role: checkbox;
                    accessible-label: @tr("models.polishing.consent.accept" => "I understand and agree to send the content described above");
                    accessible-checked: root.consent-checked;
                    accessible-enabled: true;
                    accessible-action-default => { root.consent-checked = !root.consent-checked; }
                    Rectangle {
                        x: 12px; y: 19px; width: 18px; height: 18px; border-radius: 4px; border-width: 1px; border-color: root.consent-checked ? AppColors.brand : AppColors.chart-neutral; background: root.consent-checked ? AppColors.brand : AppColors.surface;
                        if root.consent-checked: Image { x: 2px; y: 2px; width: 14px; height: 14px; source: @image-url("../../icons/lucide/check.svg"); colorize: AppColors.on-brand; }
                    }
                    Text { x: 42px; width: parent.width - 54px; text: @tr("models.polishing.consent.accept" => "I understand and agree to send the content described above"); color: AppColors.text; font-size: 11px; font-weight: 500; wrap: word-wrap; vertical-alignment: center; }
                    TouchArea { enabled: true; mouse-cursor: pointer; clicked => { root.consent-checked = !root.consent-checked; } }
                }
            }
        }

        ModelActionButton { x: consent-shell.panel-width - 268px; y: consent-shell.panel-height - 59px; width: 116px; label: @tr("common.cancel" => "Cancel"); primary: false; activated => { root.cancelled(); } }
        ModelActionButton {
            x: consent-shell.panel-width - 138px;
            y: consent-shell.panel-height - 59px;
            width: 126px;
            label: @tr("models.polishing.consent.confirm-and-test" => "Agree and test");
            primary: true;
            enabled: root.consent-checked;
            activated => { root.confirmed(); }
        }
    }
}

export component ModelsPage inherits Rectangle {
    in property <bool> focus-asr-config: false;
    in-out property <string> asr-api-key;
    in-out property <string> asr-model: "volc.seedasr.sauc.duration";
    in-out property <AsrProvider> asr-provider: AsrProvider.volcengine;
    in property <AsrProvider> active-asr-provider: AsrProvider.volcengine;
    in property <bool> cloud-asr-selected: false;
    in property <[AsrProviderCardSpec]> asr-provider-cards;
    in property <bool> macos-speech-selected: false;
    in property <SystemSpeechStatus> macos-speech-status: SystemSpeechStatus.unavailable;
    in property <bool> paraformer-downloaded: false;
    in property <string> paraformer-installed-size;
    in property <bool> paraformer-selected: false;
    in property <bool> whisper-downloaded: false;
    in property <string> whisper-installed-size;
    in property <bool> whisper-selected: false;
    in property <bool> qwen3-downloaded: false;
    in property <string> qwen3-installed-size;
    in property <bool> qwen3-selected: false;
    in property <bool> sense-voice-downloaded: false;
    in property <string> sense-voice-installed-size;
    in property <bool> sense-voice-selected: false;
    in property <bool> volcengine-asr-configured;
    in-out property <string> custom-asr-api-key;
    in-out property <string> custom-asr-base-url;
    in-out property <string> custom-asr-model;
    in property <bool> custom-asr-configured;
    in property <bool> asr-configured;
    in property <bool> asr-config-error;
    in-out property <bool> asr-draft-error: false;
    in property <string> asr-config-status;
    in-out property <bool> asr-testing: false;
    in-out property <bool> asr-pending-test: false;
    in-out property <bool> asr-config-dirty: false;
    in-out property <AsrConfigurationField> asr-error-field: AsrConfigurationField.none;
    in-out property <bool> llm-enabled;
    in-out property <LlmProvider> llm-provider: LlmProvider.sensenova;
    in property <LlmProvider> active-llm-provider: LlmProvider.sensenova;
    in property <LlmProviderConfigurationState> llm-provider-configured;
    in property <string> llm-provider-target;
    in property <bool> llm-provider-local;
    in property <string> llm-config-status;
    in-out property <bool> llm-config-dirty: false;
    in-out property <bool> llm-testing: false;
    in-out property <bool> llm-draft-error: false;
    in-out property <bool> llm-confirmation-visible: false;
    in-out property <int> active-tab: 0;
    in-out property <[string]> available-models;
    in-out property <bool> model-discovery-loading: false;
    in-out property <bool> model-discovery-error: false;
    in-out property <string> model-discovery-status;
    callback save-asr-config(AsrProvider, string, string, string);
    callback select-asr-provider(AsrProvider);
    callback open-macos-speech-details();
    callback open-asr-placeholder(AsrProviderCardKind);
    callback cancel-asr-config();
    callback request-llm-enable();
    callback set-llm-enabled(bool, string);
    callback save-llm-config(LlmProvider, string, string, string);
    callback select-llm-provider(LlmProvider);
    callback refresh-models();
    callback request-asr-test();
    callback open-key-page();
    callback open-asr-config(AsrProvider);
    callback open-llm-config(LlmProvider);

    private property <bool> service-menu-open: false;
    private property <bool> model-menu-open: false;
    private property <bool> advanced-visible: false;
    private property <bool> api-key-visible: false;
    private property <bool> manual-model: false;
    private property <bool> first-service-selected: root.active-tab == 0 ? root.asr-provider == AsrProvider.volcengine : root.llm-provider == LlmProvider.sensenova;
    private property <bool> second-service-selected: root.active-tab == 0 ? root.asr-provider == AsrProvider.custom : root.llm-provider == LlmProvider.deepseek;
    private property <bool> third-service-selected: root.active-tab == 1 && root.llm-provider == LlmProvider.custom;
    private property <bool> manual-model-selected: root.manual-model;
    private property <string> asr-model-label: root.asr-model == "volc.bigasr.sauc.duration" ? @tr("models.volcengine.model-v1" => "Doubao Streaming Speech Recognition 1.0") : @tr("models.volcengine.model-v2" => "Doubao Streaming Speech Recognition 2.0");
    private property <bool> active-config-dirty: root.active-tab == 0 ? root.asr-config-dirty : root.llm-config-dirty;
    private property <bool> active-testing: root.active-tab == 0 ? root.asr-testing : root.llm-testing;
    private property <bool> active-draft-error: root.active-tab == 0 ? root.asr-draft-error : root.llm-draft-error;
    private property <bool> service-healthy: root.active-tab == 0 ? root.asr-configured && !root.asr-config-error && !root.asr-pending-test && !root.asr-testing : root.llm-enabled;
    private property <length> config-height: root.advanced-visible ? 270px : 228px;
    private property <length> action-y: root.advanced-visible ? 560px : 525px;
    changed model-discovery-error => { if root.model-discovery-error { root.model-menu-open = true; } }
    changed asr-api-key => { root.asr-config-dirty = true; root.asr-draft-error = false; root.asr-error-field = AsrConfigurationField.none; }
    changed asr-model => { root.asr-config-dirty = true; root.asr-draft-error = false; root.asr-error-field = AsrConfigurationField.none; }
    changed custom-asr-api-key => { root.asr-config-dirty = true; root.asr-draft-error = false; root.asr-error-field = AsrConfigurationField.none; }
    changed custom-asr-base-url => { root.asr-config-dirty = true; root.asr-draft-error = false; root.asr-error-field = AsrConfigurationField.none; }
    changed custom-asr-model => { root.asr-config-dirty = true; root.asr-draft-error = false; root.asr-error-field = AsrConfigurationField.none; }
    Timer { interval: 5s; running: root.api-key-visible; triggered => { root.api-key-visible = false; } }
    background: transparent;

    Text { x: 0px; y: 44px; text: @tr("models.title" => "Models"); color: AppColors.ink; font-size: 27px; font-weight: 700; }
    transcription-tab := ModelTab { x: 0px; y: 89px; label: @tr("models.tab.speech-recognition" => "Transcription"); selected: root.active-tab == 0; activated => { root.active-tab = 0; root.service-menu-open = false; root.model-menu-open = false; root.api-key-visible = false; root.manual-model = false; } }
    ModelTab { x: transcription-tab.x + transcription-tab.width + 24px; y: 89px; label: @tr("models.tab.text-polishing" => "Polishing"); selected: root.active-tab == 1; activated => { root.active-tab = 1; root.service-menu-open = false; root.model-menu-open = false; root.api-key-visible = false; root.manual-model = false; } }

    if root.active-tab == 0: SpeechRecognitionPage {
        x: 0px;
        y: 140px;
        width: parent.width;
        height: parent.height - 140px;
        focus-config: root.focus-asr-config;
        provider-cards: root.asr-provider-cards;
        macos-speech-selected: root.macos-speech-selected;
        macos-speech-status: root.macos-speech-status;
        paraformer-downloaded: root.paraformer-downloaded;
        paraformer-installed-size: root.paraformer-installed-size;
        paraformer-selected: root.paraformer-selected;
        whisper-downloaded: root.whisper-downloaded;
        whisper-installed-size: root.whisper-installed-size;
        whisper-selected: root.whisper-selected;
        qwen3-downloaded: root.qwen3-downloaded;
        qwen3-installed-size: root.qwen3-installed-size;
        qwen3-selected: root.qwen3-selected;
        sense-voice-downloaded: root.sense-voice-downloaded;
        sense-voice-installed-size: root.sense-voice-installed-size;
        sense-voice-selected: root.sense-voice-selected;
        provider <=> root.asr-provider;
        active-provider: root.active-asr-provider;
        cloud-provider-selected: root.cloud-asr-selected;
        volcengine-api-key <=> root.asr-api-key;
        volcengine-model <=> root.asr-model;
        volcengine-configured: root.volcengine-asr-configured;
        custom-api-key <=> root.custom-asr-api-key;
        custom-base-url <=> root.custom-asr-base-url;
        custom-model <=> root.custom-asr-model;
        custom-configured: root.custom-asr-configured;
        config-error: root.asr-config-error;
        draft-error <=> root.asr-draft-error;
        config-status: root.asr-config-status;
        testing <=> root.asr-testing;
        pending-test <=> root.asr-pending-test;
        config-dirty <=> root.asr-config-dirty;
        error-field <=> root.asr-error-field;
        select-provider(provider) => { root.select-asr-provider(provider); }
        open-macos-speech-details => { root.open-macos-speech-details(); }
        open-placeholder-details(kind) => { root.open-asr-placeholder(kind); }
        open-config(original-provider) => { root.open-asr-config(original-provider); }
    }

    if root.active-tab == 1: TextPolishingPage {
        x: 0px;
        y: 140px;
        width: parent.width;
        height: parent.height - 140px;
        llm-enabled: root.llm-enabled;
        testing: root.llm-testing;
        current-provider: root.active-llm-provider;
        configured: root.llm-provider-configured;
        toggle-enabled => {
            if root.llm-enabled { root.set-llm-enabled(false, root.llm-provider-target); }
            else { root.request-llm-enable(); }
        }
        open-provider(provider) => {
            root.llm-provider = provider;
            root.open-llm-config(provider);
        }
    }
}
