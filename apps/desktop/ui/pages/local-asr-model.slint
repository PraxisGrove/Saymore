import { AsrProviderCardKind, ModalShell, ModalSize } from "../components.slint";
import { AppColors } from "../color-system.slint";
import { AsrProviderLogo } from "asr-provider-card.slint";
import { DeleteIconButton } from "../delete-icon-button.slint";
import { LocalAsrProduct, LocalAsrProducts } from "local-asr-products.slint";
import { LocalAsrIntroduction } from "local-asr-introduction.slint";
import { LocalAsrUsage } from "local-asr-usage.slint";
import { LocalRecognitionMode } from "recognition-mode-control.slint";
import { LocalModelDownloadState, LocalModelActionButton } from "local-asr-controls.slint";
export { LocalModelDownloadState } from "local-asr-controls.slint";

export component LocalAsrModelModal inherits Rectangle {
    in property <AsrProviderCardKind> kind: AsrProviderCardKind.qwen3-asr;
    in property <LocalModelDownloadState> download-state: LocalModelDownloadState.not-downloaded;
    in property <float> download-progress: 0;
    in property <bool> download-supported: false;
    in property <bool> import-supported: false;
    in property <bool> adapter-ready: false;
    in property <bool> selected: false;
    in property <bool> selection-pending: false;
    in property <string> download-size;
    in property <string> installed-size;
    in property <bool> runtime-memory-live: false;
    in property <string> runtime-memory-usage;
    in property <string> operation-error;
    in property <bool> testing: false;
    in property <bool> test-succeeded: false;
    in property <bool> test-failed: false;
    in property <string> test-elapsed;
    in property <string> test-result;
    in property <string> download-error;
    in property <LocalRecognitionMode> qwen-mode: LocalRecognitionMode.non-streaming;
    callback qwen-mode-changed(LocalRecognitionMode);
    in property <LocalRecognitionMode> whisper-mode: LocalRecognitionMode.non-streaming;
    callback whisper-mode-changed(LocalRecognitionMode);
    callback cancelled();
    callback import-requested();
    callback download-requested(AsrProviderCardKind);
    callback pause-requested(AsrProviderCardKind);
    callback cancel-download-requested(AsrProviderCardKind);
    callback delete-requested(AsrProviderCardKind);
    callback select-provider(AsrProviderCardKind);
    callback run-test(AsrProviderCardKind);
    callback refresh-runtime-memory(AsrProviderCardKind);

    private property <float> bounded-progress: max(0, min(1, root.download-progress));
    private property <int> progress-percent: round(root.bounded-progress * 100);
    private property <bool> whisper: root.kind == AsrProviderCardKind.whisper-large-v3-turbo;
    private property <LocalAsrProduct> product: LocalAsrProducts.for-kind(root.kind);
    private property <string> fixed-mode: root.kind == AsrProviderCardKind.seaco-paraformer
        ? @tr("models.asr.mode.non-streaming" => "Non-streaming")
        : root.kind == AsrProviderCardKind.zipformer ? @tr("models.asr.mode.streaming" => "Streaming") : "";
    private property <bool> not-installed: root.download-state == LocalModelDownloadState.not-downloaded;
    private property <bool> installed: root.download-state == LocalModelDownloadState.downloaded;
    private property <bool> queued: root.download-state == LocalModelDownloadState.queued;
    private property <bool> downloading: root.download-state == LocalModelDownloadState.downloading;
    private property <bool> paused: root.download-state == LocalModelDownloadState.paused;
    private property <bool> cancelling: root.download-state == LocalModelDownloadState.cancelling;
    private property <bool> in-use: root.installed && root.selected && !root.selection-pending;
    private property <bool> test-ready: root.installed && root.adapter-ready && !root.selection-pending;
    private property <string> status: root.selection-pending ? @tr("models.asr.selection.activating" => "Switching")
        : root.in-use ? @tr("models.asr.whisper.in-use" => "In use")
        : root.installed && !root.adapter-ready ? @tr("models.asr.whisper.unverified-device" => "Installed · Device unverified")
        : root.installed ? @tr("models.asr.whisper.inactive" => "Installed · Not in use")
        : root.downloading ? @tr("models.asr.local.downloading-percent" => "Downloading {}%", root.progress-percent)
        : root.queued ? @tr("models.asr.local.queued" => "Queued")
        : root.paused ? @tr("models.asr.local.paused" => "Paused") + " · " + root.progress-percent + "%"
        : root.cancelling ? @tr("models.asr.local.cancelling" => "Cancelling")
        : @tr("models.asr.whisper.not-installed" => "Not installed");
    private property <string> warning-message: !root.operation-error.is-empty ? root.operation-error
        : !root.download-error.is-empty ? root.download-error
        : root.not-installed && !root.download-supported && !root.import-supported
            ? @tr("models.asr.placeholder.download-disabled" => "No verified download source or production adapter is available.") : "";

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            return reject;
        }

        dialog := ModalShell {
            width: parent.width;
            height: parent.height;
            size: ModalSize.standard;
            private property <bool> tight-header: warning.visible && root.height <= 600px;
            private property <length> footer-height: self.tight-header ? 52px : 64px;
            panel-height-override: body.y + body.preferred-height + self.footer-height;
            close-requested => { root.cancelled(); }

            AsrProviderLogo {
                private property <bool> intro-logo: !root.installed;
                x: self.intro-logo ? 20px : 24px;
                y: self.intro-logo ? 17px : 22px;
                width: self.intro-logo ? 52px : 42px;
                height: self.width;
                source: root.product.icon;
                colorized: root.kind == AsrProviderCardKind.zipformer || (root.whisper && AppColors.dark-mode);
                needs-dark-backplate: root.kind == AsrProviderCardKind.seaco-paraformer;
            }
            Text {
                x: 80px;
                y: 18px;
                width: dialog.panel-width - 146px;
                text: root.product.name;
                color: AppColors.ink;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                x: 80px;
                y: 45px;
                width: dialog.panel-width - 146px;
                text: root.whisper && root.installed ? @tr("models.asr.whisper.installed-subtitle" => "OpenAI · Offline multilingual recognition")
                    : root.whisper ? @tr("models.asr.whisper.subtitle" => "OpenAI · Local speech recognition")
                    : @tr("models.asr.summary.no-network" => "Offline") + " · " + root.product.language;
                color: AppColors.text-muted;
                font-size: 12px;
                overflow: elide;
            }
            warning := Text {
                visible: !root.warning-message.is-empty;
                x: 28px; y: dialog.tight-header ? 68px : 81px; width: dialog.panel-width - 56px;
                height: self.visible ? min(self.preferred-height, max(0px,
                    dialog.maximum-panel-height - self.y - 8px - body.preferred-height - dialog.footer-height)) : 0px;
                text: root.warning-message;
                color: AppColors.danger; font-size: 12px; wrap: word-wrap; overflow: elide;
                Tooltip { text: @markdown("\{warning.height < warning.preferred-height ? warning.text : ""}"); }
            }
            body := VerticalLayout {
                x: warning.x; y: warning.y + warning.height + (warning.visible ? 8px : 0px);
                width: warning.width; height: self.preferred-height;
                padding-bottom: dialog.tight-header ? 8px : 14px;
                if !root.installed: LocalAsrIntroduction {
                    product: root.product;
                    fixed-mode: root.fixed-mode;
                    show-memory-estimate: root.whisper;
                    compatible: root.adapter-ready;
                }
                if root.installed: LocalAsrUsage {
                    fixed-mode: root.fixed-mode;
                    separate-recognition-process: root.kind == AsrProviderCardKind.qwen3-asr;
                    mode: root.whisper ? root.whisper-mode
                        : root.kind == AsrProviderCardKind.qwen3-asr ? root.qwen-mode
                        : root.kind == AsrProviderCardKind.zipformer ? LocalRecognitionMode.streaming : LocalRecognitionMode.non-streaming;
                    selected: root.selected; pending: root.selection-pending;
                    ready: root.adapter-ready; testing: root.testing;
                    test-succeeded: root.test-succeeded; test-failed: root.test-failed;
                    test-elapsed: root.test-elapsed; test-result: root.test-result;
                    installed-size: root.installed-size;
                    sampled-memory: root.adapter-ready && root.runtime-memory-live ? root.runtime-memory-usage : "";
                    mode-changed(mode) => {
                        if root.kind == AsrProviderCardKind.qwen3-asr { root.qwen-mode-changed(mode); }
                        else if root.whisper { root.whisper-mode-changed(mode); }
                    }
                    run-test => { root.run-test(root.kind); }
                }
            }

            Rectangle {
                x: 28px; y: dialog.panel-height - self.height;
                width: dialog.panel-width - 56px; height: dialog.footer-height;
                private property <bool> can-cancel: root.queued || root.downloading || root.paused;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: AppColors.border; }
                if root.downloading || root.paused: Rectangle {
                    x: 0px; y: 0px; width: parent.width * root.bounded-progress; height: 2px; background: AppColors.brand;
                }
                HorizontalLayout {
                    width: parent.width; height: parent.height; spacing: 8px; cross-axis-alignment: center;
                    Rectangle {
                        width: 7px; height: 7px; border-radius: 4px;
                        background: root.in-use ? AppColors.success : AppColors.chart-neutral;
                    }
                    Text {
                        horizontal-stretch: 1; font-size: 12px; color: AppColors.text-muted; wrap: word-wrap;
                        text: root.status;
                    }
                    if root.import-supported && root.not-installed: LocalModelActionButton {
                        text: @tr("models.asr.local.import" => "Import model");
                        accessible-description: @tr("models.asr.local.import-help" => "Select the folder for this model version. Saymore verifies the files before importing.");
                        enabled: !root.selection-pending;
                        primary: !root.download-supported;
                        clicked => { root.import-requested(); }
                    }
                    if parent.can-cancel: LocalModelActionButton {
                        text: @tr("models.asr.local.cancel" => "Cancel");
                        clicked => { root.cancel-download-requested(root.kind); }
                    }
                    if root.installed: DeleteIconButton {
                        accessible-label: @tr("settings.storage.remove-model" => "Remove model");
                        enabled: !root.selected && !root.selection-pending && !root.testing;
                        accessible-description: root.selected ? @tr("models.asr.local.delete-current-disabled" => "Switch providers to delete") : "";
                        activated => { root.delete-requested(root.kind); }
                    }
                    if !(root.installed && (root.selected || root.selection-pending)) && !root.queued && !root.cancelling
                        && !(root.not-installed && root.import-supported && !root.download-supported): LocalModelActionButton {
                        text: root.installed ? @tr("models.asr.local.use" => "Use model")
                            : root.downloading ? @tr("models.asr.local.pause" => "Pause")
                            : root.paused ? @tr("models.asr.local.continue" => "Continue")
                            : root.not-installed && !root.download-size.is-empty
                                ? @tr("models.asr.whisper.download-size" => "Download · {}", root.download-size)
                            : @tr("models.asr.local.download-action" => "Download");
                        enabled: root.installed ? root.test-ready && !root.selected && !root.testing : root.downloading || root.download-supported;
                        primary: !root.downloading;
                        clicked => {
                            if root.installed { root.select-provider(root.kind); }
                            else if root.downloading { root.pause-requested(root.kind); }
                            else { root.download-requested(root.kind); }
                        }
                    }
                }
            }
        }
    }
    Timer {
        interval: 2s;
        running: root.in-use && root.adapter-ready;
        triggered => { root.refresh-runtime-memory(root.kind); }
    }
    init => { modal-focus.focus(); }
    changed visible => { if root.visible { modal-focus.focus(); } }
}

export component LocalModelDownloadFailureDialog inherits Rectangle {
    in property <string> detail;
    in property <bool> insufficient-space: false;
    callback retry();
    callback later();
    callback manage-space();

    failure-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.later(); return accept; }
            return reject;
        }

        failure-shell := ModalShell {
            width: parent.width;
            height: parent.height;
            size: ModalSize.compact;
            panel-height-override: root.insufficient-space ? 264px : 220px;
            close-requested => { root.later(); }

            Rectangle {
                x: 24px;
                y: 22px;
                width: 38px;
                height: 38px;
                border-radius: 8px;
                background: AppColors.danger-soft;
                Image {
                    x: 9px;
                    y: 9px;
                    width: 20px;
                    height: 20px;
                    source: @image-url("../../icons/lucide/circle-alert.svg");
                    colorize: AppColors.danger;
                }
            }
            Text {
                x: 76px;
                y: 20px;
                width: failure-shell.panel-width - 136px;
                text: @tr("models.asr.local.download-failure.title" => "Model download failed");
                color: AppColors.ink;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                x: 24px;
                y: 78px;
                width: failure-shell.panel-width - 48px;
                height: 62px;
                text: root.detail;
                color: AppColors.text-muted;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
            }
            if root.insufficient-space: LocalModelActionButton {
                x: 24px;
                y: failure-shell.panel-height - 98px;
                text: @tr("models.asr.local.download-failure.manage-space" => "Manage space");
                clicked => { root.manage-space(); }
            }
            later-button := LocalModelActionButton {
                x: retry-button.x - self.width - 12px;
                y: failure-shell.panel-height - 54px;
                text: @tr("models.asr.local.download-failure.later" => "Later");
                clicked => { root.later(); }
            }
            retry-button := LocalModelActionButton {
                x: failure-shell.panel-width - self.width - 24px;
                y: failure-shell.panel-height - 54px;
                text: @tr("models.asr.local.download-failure.retry" => "Continue download");
                primary: true;
                clicked => { root.retry(); }
            }
        }
    }
    init => { failure-focus.focus(); }
}
