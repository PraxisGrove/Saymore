import { AsrProviderCardKind, ModalShell, ModalSize } from "../components.slint";
import { AppColors } from "../color-system.slint";
import { RecognitionTestPanel } from "asr-recognition-test.slint";

import { LocalModelDownloadState, PunctuationMode, LocalModelSummaryPill, LocalModelMetric, LocalModelActionButton, LocalModelSelectionControl } from "local-asr-controls.slint";
export { LocalModelDownloadState, PunctuationMode } from "local-asr-controls.slint";

export component LocalAsrModelModal inherits Rectangle {
    in property <AsrProviderCardKind> kind: AsrProviderCardKind.qwen3-asr;
    in property <LocalModelDownloadState> download-state: LocalModelDownloadState.not-downloaded;
    in property <float> download-progress: 0;
    in property <bool> download-supported: false;
    in property <bool> adapter-ready: false;
    in property <bool> selected: false;
    in property <bool> selection-pending: false;
    in property <string> download-size;
    in property <string> installed-size;
    in property <bool> runtime-memory-live: false;
    in property <string> runtime-memory-usage;
    in property <string> operation-error;
    in property <bool> testing: false;
    in property <bool> test-succeeded: false;
    in property <bool> test-failed: false;
    in property <string> test-elapsed;
    in property <string> test-result;
    in property <string> download-error;
    in property <bool> llm-enabled: false;
    in property <PunctuationMode> punctuation-mode: PunctuationMode.llm;
    in property <LocalModelDownloadState> punctuation-download-state: LocalModelDownloadState.not-downloaded;
    in property <float> punctuation-download-progress: 0;
    in property <string> punctuation-download-size: "";
    in property <string> punctuation-installed-size: "";
    in property <bool> punctuation-runtime-live: false;
    in property <string> punctuation-runtime-memory: "";
    in property <bool> punctuation-pending: false;
    in property <string> punctuation-error: "";
    callback cancelled();
    callback download-requested(AsrProviderCardKind);
    callback pause-requested(AsrProviderCardKind);
    callback cancel-download-requested(AsrProviderCardKind);
    callback delete-requested(AsrProviderCardKind);
    callback select-provider(AsrProviderCardKind);
    callback run-test(AsrProviderCardKind);
    callback refresh-runtime-memory(AsrProviderCardKind);
    callback punctuation-mode-requested(PunctuationMode);
    callback punctuation-download-requested();
    callback punctuation-delete-requested();
    callback open-llm-settings();

    private property <float> bounded-progress: max(0, min(1, root.download-progress));
    private property <int> progress-percent: round(root.bounded-progress * 100);
    private property <string> title: root.kind == AsrProviderCardKind.qwen3-asr ? "Qwen3-ASR 1.7B"
        : root.kind == AsrProviderCardKind.paraformer ? "Paraformer-zh"
        : root.kind == AsrProviderCardKind.sense-voice-small ? "SenseVoiceSmall"
        : "Whisper large-v3-turbo";
    private property <string> memory-estimate: root.kind == AsrProviderCardKind.qwen3-asr ? "4.3 GB"
        : root.kind == AsrProviderCardKind.paraformer ? "503 MB"
        : root.kind == AsrProviderCardKind.sense-voice-small ? "573 MB"
        : "2.15 GB";
    private property <bool> showing-live-memory: !root.selection-pending && root.runtime-memory-live && root.runtime-memory-usage != "";
    private property <string> memory-display: root.selection-pending
        ? @tr("models.asr.local.memory-loading" => "Loading model…")
        : root.showing-live-memory
        ? root.runtime-memory-usage
        : @tr("models.asr.local.memory-approximate" => "Approx. {}", root.memory-estimate);
    private property <bool> installed: root.download-state == LocalModelDownloadState.downloaded;
    private property <bool> queued: root.download-state == LocalModelDownloadState.queued;
    private property <bool> downloading: root.download-state == LocalModelDownloadState.downloading;
    private property <bool> paused: root.download-state == LocalModelDownloadState.paused;
    private property <bool> cancelling: root.download-state == LocalModelDownloadState.cancelling;
    private property <bool> test-ready: root.installed && root.adapter-ready && !root.selection-pending;
    private property <string> model-status: root.selection-pending
        ? @tr("models.asr.local.status.switching" => "Switching · {}", root.title)
        : root.downloading
        ? @tr("models.asr.local.status.downloading" => "Downloading · {}", root.title)
        : root.queued
            ? @tr("models.asr.local.status.queued" => "Queued · {}", root.title)
        : root.paused
            ? @tr("models.asr.local.status.paused" => "Paused · {}", root.title)
            : root.cancelling
                ? @tr("models.asr.local.status.cancelling" => "Cancelling download · {}", root.title)
        : root.installed
            ? @tr("models.asr.local.status.downloaded" => "Downloaded · {}", root.title)
            : @tr("models.asr.local.status.not-downloaded" => "Not downloaded · {}", root.title);
    private property <string> model-detail: root.operation-error != ""
        ? root.operation-error
        : root.selection-pending
            ? @tr("models.asr.local.activation-loading" => "Loading the model into memory")
        : root.download-error != ""
        ? root.download-error
        : !root.download-supported
        ? @tr("models.asr.placeholder.download-disabled" => "No verified download source or production adapter is available.")
        : root.downloading
            ? @tr("models.asr.local.progress-detail" => "{}% of {}", root.progress-percent, root.download-size)
            : root.queued
                ? @tr("models.asr.local.queued-detail" => "Waiting for an available download slot")
            : root.paused
                ? @tr("models.asr.local.paused-detail" => "{}% of {} · Continue when ready", root.progress-percent, root.download-size)
                : root.cancelling
                    ? @tr("models.asr.local.cancelling-detail" => "Removing downloaded temporary files…")
            : root.installed && root.selected
                ? @tr("models.asr.local.delete-current-disabled" => "Switch providers to delete")
                : root.installed
                    ? @tr("models.asr.local.delete-ready-size" => "Stored locally · {} on disk", root.installed-size)
                    : @tr("models.asr.local.download-ready" => "Download to use this model offline");
    private property <string> action-label: root.downloading
        ? @tr("models.asr.local.downloading-percent" => "Downloading {}%", root.progress-percent)
        : root.queued ? @tr("models.asr.local.queued" => "Queued")
        : root.paused ? @tr("models.asr.local.continue" => "Continue")
        : root.cancelling ? @tr("models.asr.local.cancelling" => "Cancelling")
        : root.installed ? @tr("models.asr.local.delete" => "Delete")
        : @tr("models.asr.local.download-action" => "Download");
    private property <bool> action-enabled: root.cancelling || root.queued ? false
        : root.installed
        ? !root.selected && !root.selection-pending
        : root.download-supported;
    private property <string> output-mode: root.kind == AsrProviderCardKind.paraformer
        ? @tr("models.asr.local.output.streaming" => "Streaming")
        : @tr("models.asr.local.output.non-streaming" => "Final only");
    private property <string> usage-tip: root.kind == AsrProviderCardKind.paraformer
        ? @tr("models.asr.local.usage-tip.paraformer" => "Lightweight live Chinese and Chinese-English dictation. Best with an LLM.")
        : root.kind == AsrProviderCardKind.whisper-large-v3-turbo
            ? @tr("models.asr.local.usage-tip.whisper" => "Multilingual dictation with higher memory use. Text appears after speaking.")
        : root.kind == AsrProviderCardKind.sense-voice-small
            ? @tr("models.asr.local.usage-tip.sensevoice" => "Lightweight five-language transcription. Final text only.")
            : @tr("models.asr.local.usage-tip.qwen3" => "Handles dialects, multiple languages, and complex speech. Needs a stronger device.");

    modal-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            return reject;
        }

        dialog := ModalShell {
            width: parent.width;
            height: parent.height;
            size: ModalSize.standard;
            close-requested => { root.cancelled(); }

            Image {
                x: 24px;
                y: 22px;
                width: 42px;
                height: 42px;
                source: root.kind == AsrProviderCardKind.qwen3-asr
                    ? @image-url("../../icons/providers/qwen.png")
                    : root.kind == AsrProviderCardKind.paraformer || root.kind == AsrProviderCardKind.sense-voice-small
                        ? @image-url("../../icons/providers/funasr.png")
                        : @image-url("../../icons/providers/openai.png");
                image-fit: contain;
            }
            Text {
                x: 80px;
                y: 18px;
                width: dialog.panel-width - 276px;
                text: root.title;
                color: AppColors.ink;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                x: 80px;
                y: 45px;
                width: dialog.panel-width - 276px;
                text: root.download-supported
                    ? @tr("models.asr.local.subtitle.verified" => "Open source · Verified")
                    : root.kind == AsrProviderCardKind.sense-voice-small
                        ? @tr("models.asr.local.subtitle.sensevoice" => "Lightweight five-language model · Final only · INT8")
                    : @tr("models.asr.local.subtitle.pending" => "Open source · Verification pending");
                color: AppColors.text-muted;
                font-size: 12px;
                overflow: elide;
            }
            LocalModelSelectionControl {
                x: dialog.panel-width - self.width - 54px;
                y: 16px;
                download-state: root.download-state;
                selected: root.selected;
                pending: root.selection-pending;
                enabled: root.installed && root.adapter-ready && !root.selected && !root.selection-pending;
                activated => { root.select-provider(root.kind); }
            }

            detail-body := Flickable {
                x: 0px;
                y: 72px;
                width: dialog.panel-width;
                height: dialog.panel-height - 88px;
                viewport-width: self.width;
                viewport-height: max(self.height, usage-tip.y + usage-tip.height + 12px);
                interactive: self.viewport-height > self.height;

            LocalModelSummaryPill { x: 24px; y: 8px; icon: @image-url("../../icons/lucide/monitor.svg"); label: @tr("models.asr.summary.local-processing" => "Local"); }
            LocalModelSummaryPill { x: 153px; y: 8px; icon: @image-url("../../icons/lucide/globe.svg"); label: @tr("models.asr.summary.no-network" => "Offline"); }
            LocalModelSummaryPill {
                x: 281px;
                y: 8px;
                icon: @image-url("../../icons/lucide/book-open.svg");
                label: root.kind == AsrProviderCardKind.paraformer
                    ? @tr("models.asr.summary.chinese-english" => "ZH · EN")
                    : root.kind == AsrProviderCardKind.whisper-large-v3-turbo
                        ? @tr("models.asr.summary.multilingual" => "Multilingual")
                    : root.kind == AsrProviderCardKind.qwen3-asr
                        ? @tr("models.asr.summary.chinese-dialects" => "ZH · Dialects")
                    : @tr("models.asr.summary.five-languages" => "ZH · EN · JA · KO · YUE");
            }
            LocalModelSummaryPill { x: 410px; y: 8px; icon: @image-url("../../icons/lucide/file-text.svg"); label: root.output-mode; }

            metrics := Rectangle {
                x: 28px;
                y: root.kind == AsrProviderCardKind.paraformer ? 61px : 68px;
                width: 486px;
                height: 52px;
                background: transparent;

                LocalModelMetric {
                    x: 0px;
                    width: parent.width / 3;
                    height: parent.height;
                    content-offset: 12px;
                    icon: @image-url("../../icons/lucide/download.svg");
                    label: @tr("models.asr.local.download-size" => "Download");
                    value: root.download-size;
                }
                LocalModelMetric {
                    x: parent.width / 3;
                    width: parent.width / 3;
                    height: parent.height;
                    content-offset: 12px;
                    icon: @image-url("../../icons/lucide/memory-stick.svg");
                    label: root.showing-live-memory
                        ? @tr("models.asr.local.memory-current" => "Memory")
                        : @tr("models.asr.local.memory" => "Memory");
                    value: root.memory-display;
                    live-value: root.showing-live-memory;
                    muted-value: root.selection-pending;
                }
                LocalModelMetric {
                    x: parent.width * 2 / 3;
                    width: parent.width / 3;
                    height: parent.height;
                    content-offset: 12px;
                    icon: @image-url("../../icons/lucide/badge-check.svg");
                    label: @tr("models.asr.local.compatibility" => "Device");
                    value: root.adapter-ready
                        ? @tr("models.asr.status.supported" => "Supported")
                        : @tr("models.asr.placeholder.unverified" => "Unverified");
                    muted-value: !root.adapter-ready;
                }
            }

            if root.kind == AsrProviderCardKind.paraformer: Text {
                x: 40px;
                y: 144px;
                text: @tr("models.asr.local.model-settings" => "Model settings");
                color: AppColors.text-muted;
                font-size: 12px;
                font-weight: 500;
            }

            model-files := Rectangle {
                x: 28px;
                y: root.kind == AsrProviderCardKind.paraformer ? 166px : 132px;
                width: 486px;
                height: model-detail.y + model-detail.height + 12px;
                background: transparent;

                Image { x: 12px; y: 10px; width: 15px; height: 15px; source: @image-url("../../icons/lucide/package-check.svg"); colorize: AppColors.text-muted; }
                Text { x: 34px; y: 9px; text: @tr("models.asr.local.model-files" => "Files"); color: AppColors.text; font-size: 12px; font-weight: 700; }
                model-action := LocalModelActionButton {
                    x: parent.width - self.width - 16px;
                    y: 13px;
                    visible: !root.cancelling;
                    label: root.action-label;
                    hover-label: root.downloading ? @tr("models.asr.local.pause" => "Pause") : "";
                    enabled: root.action-enabled;
                    primary: !root.installed && !root.queued && !root.downloading && !root.paused;
                    pending: root.downloading;
                    danger: root.installed && !root.selected;
                    activated => {
                        if root.installed { root.delete-requested(root.kind); }
                        else if root.downloading { root.pause-requested(root.kind); }
                        else { root.download-requested(root.kind); }
                    }
                }
                if root.queued || root.downloading || root.paused: Rectangle {
                    x: model-action.x - self.width - 8px;
                    y: 13px;
                    width: 46px;
                    height: 32px;
                    background: transparent;
                    accessible-role: button;
                    accessible-label: @tr("models.asr.local.cancel" => "Cancel");
                    accessible-action-default => { root.cancel-download-requested(root.kind); }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: @tr("models.asr.local.cancel" => "Cancel");
                        color: cancel-touch.has-hover ? AppColors.danger : AppColors.text-muted;
                        font-size: 12px;
                        font-weight: 650;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel-download-requested(root.kind); }
                    }
                }
                Text { x: 34px; y: 56px; width: parent.width - 50px; text: root.model-status; color: AppColors.ink; font-size: 12px; font-weight: 600; overflow: elide; }
                model-detail := Text { x: 34px; y: 78px; width: parent.width - 50px; height: max(32px, self.preferred-height); text: root.model-detail; color: root.operation-error != "" ? AppColors.danger : AppColors.text-muted; font-size: 11px; wrap: word-wrap; }
                if root.downloading || root.paused: Rectangle {
                    x: model-action.x;
                    y: 49px;
                    width: model-action.width;
                    height: 4px;
                    border-radius: 2px;
                    background: AppColors.selected;
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * root.bounded-progress;
                        height: parent.height;
                        border-radius: 2px;
                        background: AppColors.brand;
                        animate width { duration: 180ms; easing: ease-out; }
                    }
                }
                if root.cancelling: LocalModelActionButton {
                    x: parent.width - self.width - 16px;
                    y: 13px;
                    label: @tr("models.asr.local.cancelling" => "Cancelling");
                    enabled: false;
                    pending: true;
                }
            }

            punctuation-settings := Rectangle {
                visible: root.kind == AsrProviderCardKind.paraformer;
                x: 28px;
                y: model-files.y + model-files.height + 12px;
                width: 486px;
                height: max(108px, punctuation-description.y + punctuation-description.height + 12px);
                background: transparent;

                Image { x: 12px; y: 12px; width: 14px; height: 14px; source: @image-url("../../icons/lucide/message-square-text.svg"); colorize: AppColors.text-muted; }
                Text { x: 32px; y: 7px; text: @tr("models.asr.punctuation.title" => "Punctuation"); color: AppColors.text; font-size: 12px; font-weight: 700; }
                Text {
                    x: 32px; y: 31px; width: 300px;
                    text: root.punctuation-mode == PunctuationMode.llm
                        ? root.llm-enabled
                            ? @tr("models.asr.punctuation.llm-enabled" => "LLM polishing is enabled")
                            : @tr("models.asr.punctuation.llm-disabled" => "LLM is not enabled")
                        : root.punctuation-download-state == LocalModelDownloadState.downloaded
                            ? @tr("models.asr.punctuation.local-enabled" => "Local punctuation enabled")
                            : @tr("models.asr.punctuation.local-missing" => "Local model not downloaded");
                    color: root.punctuation-error != "" ? AppColors.danger
                        : root.punctuation-mode == PunctuationMode.local && root.punctuation-download-state == LocalModelDownloadState.downloaded ? AppColors.success
                        : root.punctuation-mode == PunctuationMode.llm && !root.llm-enabled ? AppColors.warning
                        : AppColors.text;
                    font-size: 12px; font-weight: 650; overflow: elide;
                }
                punctuation-description := Text {
                    x: 32px; y: 54px; width: 280px;
                    height: max(36px, self.preferred-height);
                    text: root.punctuation-error != "" ? root.punctuation-error
                        : root.punctuation-mode == PunctuationMode.llm
                            ? @tr("models.asr.punctuation.llm-description" => "LLM adds punctuation and improves sentence breaks.")
                            : root.punctuation-download-state == LocalModelDownloadState.downloaded
                                ? @tr("models.asr.punctuation.local-description" => "Offline · {} on disk{}", root.punctuation-installed-size, root.punctuation-runtime-live ? @tr("models.asr.punctuation.loaded" => " · loaded") : "")
                                : @tr("models.asr.punctuation.download-description" => "Download {} to restore punctuation fully offline.", root.punctuation-download-size);
                    color: AppColors.text-muted; font-size: 11px; wrap: word-wrap; overflow: elide;
                }

                Rectangle {
                    x: parent.width - self.width - 16px; y: 0px; width: 112px; height: 28px;
                    border-radius: 14px; background: AppColors.surface-faint;
                    Rectangle {
                        x: root.punctuation-mode == PunctuationMode.llm ? 2px : 56px;
                        y: 2px; width: 54px; height: 24px; border-radius: 12px;
                        border-width: 1px; border-color: AppColors.border;
                        background: AppColors.surface;
                        animate x { duration: 150ms; easing: ease-out; }
                    }
                    Text { x: 0px; width: 56px; height: parent.height; text: "LLM"; color: root.punctuation-mode == PunctuationMode.llm ? AppColors.brand-strong : AppColors.text-muted; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                    Text { x: 56px; width: 56px; height: parent.height; text: @tr("models.asr.punctuation.local" => "Local"); color: root.punctuation-mode == PunctuationMode.local ? AppColors.brand-strong : AppColors.text-muted; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                    Rectangle {
                        x: 0px; y: -8px; width: 56px; height: 44px; background: transparent;
                        accessible-role: tab;
                        accessible-label: "LLM";
                        accessible-enabled: !root.punctuation-pending && root.punctuation-download-state != LocalModelDownloadState.downloading;
                        accessible-action-default => {
                            if !root.punctuation-pending && root.punctuation-download-state != LocalModelDownloadState.downloading {
                                root.punctuation-mode-requested(PunctuationMode.llm);
                            }
                        }
                        TouchArea { enabled: !root.punctuation-pending && root.punctuation-download-state != LocalModelDownloadState.downloading; mouse-cursor: self.enabled ? pointer : default; clicked => { root.punctuation-mode-requested(PunctuationMode.llm); } }
                    }
                    Rectangle {
                        x: 56px; y: -8px; width: 56px; height: 44px; background: transparent;
                        accessible-role: tab;
                        accessible-label: @tr("models.asr.punctuation.local" => "Local");
                        accessible-enabled: !root.punctuation-pending && root.punctuation-download-state != LocalModelDownloadState.downloading;
                        accessible-action-default => {
                            if !root.punctuation-pending && root.punctuation-download-state != LocalModelDownloadState.downloading {
                                root.punctuation-mode-requested(PunctuationMode.local);
                            }
                        }
                        TouchArea { enabled: !root.punctuation-pending && root.punctuation-download-state != LocalModelDownloadState.downloading; mouse-cursor: self.enabled ? pointer : default; clicked => { root.punctuation-mode-requested(PunctuationMode.local); } }
                    }
                }
                if root.punctuation-mode == PunctuationMode.llm && !root.llm-enabled: Rectangle {
                    x: parent.width - self.width - 16px; y: 31px; width: 130px; height: 44px; background: transparent;
                    accessible-role: button;
                    accessible-label: @tr("models.asr.punctuation.open-llm" => "Enable LLM");
                    accessible-action-default => { root.open-llm-settings(); }
                    Text { x: 5px; y: 8px; width: 100px; height: 28px; text: @tr("models.asr.punctuation.open-llm" => "Enable LLM"); color: AppColors.brand-strong; font-size: 12px; font-weight: 650; horizontal-alignment: right; vertical-alignment: center; }
                    Image { x: 108px; y: 16px; width: 12px; height: 12px; source: @image-url("../../icons/lucide/arrow-right.svg"); colorize: AppColors.brand; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.open-llm-settings(); } }
                }
                if root.punctuation-mode == PunctuationMode.local && root.punctuation-download-state != LocalModelDownloadState.downloaded: LocalModelActionButton {
                    x: parent.width - self.width - 16px; y: 42px; height: 32px;
                    label: root.punctuation-download-state == LocalModelDownloadState.downloading
                        ? @tr("models.asr.local.downloading-percent" => "Downloading {}%", round(root.punctuation-download-progress * 100))
                        : @tr("models.asr.punctuation.download-enable" => "Download & enable");
                    primary: root.punctuation-download-state != LocalModelDownloadState.downloading;
                    pending: root.punctuation-download-state == LocalModelDownloadState.downloading;
                    enabled: !root.punctuation-pending && root.punctuation-download-state != LocalModelDownloadState.downloading;
                    activated => { root.punctuation-download-requested(); }
                }
                if root.punctuation-mode == PunctuationMode.local && root.punctuation-download-state == LocalModelDownloadState.downloaded: Rectangle {
                    x: parent.width - self.width - 16px; y: 42px; width: 130px; height: 32px; background: transparent;
                    Text { width: parent.width; height: parent.height; text: @tr("models.asr.punctuation.delete" => "Delete local model"); color: delete-punctuation.has-hover ? AppColors.danger : AppColors.text-muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    delete-punctuation := TouchArea { mouse-cursor: pointer; clicked => { root.punctuation-delete-requested(); } }
                }
            }

            recognition-test := RecognitionTestPanel {
                x: 28px;
                y: root.kind == AsrProviderCardKind.paraformer
                    ? punctuation-settings.y + punctuation-settings.height + 12px
                    : model-files.y + model-files.height + 16px;
                width: 486px;
                background: AppColors.surface-faint;
                testing: root.testing;
                succeeded: root.test-succeeded;
                failed: root.test-failed;
                ready: root.test-ready;
                elapsed: root.test-elapsed;
                transcript: root.test-result;
                activated => { root.run-test(root.kind); }
            }

            usage-tip := Text {
                x: 28px;
                y: recognition-test.y + recognition-test.height + 16px;
                width: dialog.panel-width - 56px;
                height: max(36px, self.preferred-height);
                text: root.usage-tip;
                color: AppColors.text;
                font-size: 12px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            }

            if detail-body.viewport-height > detail-body.height: Rectangle {
                x: dialog.panel-width - 12px;
                y: detail-body.y + 8px;
                width: 3px;
                height: detail-body.height - 16px;
                border-radius: 1.5px;
                background: AppColors.border;
                opacity: scroll-touch.has-hover || scroll-touch.pressed ? 0.9 : 0.55;
                animate opacity { duration: 120ms; easing: ease-out; }

                scroll-thumb := Rectangle {
                    x: 0px;
                    width: parent.width;
                    height: max(32px, parent.height * detail-body.height / detail-body.viewport-height);
                    y: (0px - detail-body.viewport-y) / (detail-body.viewport-height - detail-body.height) * (parent.height - self.height);
                    border-radius: 1.5px;
                    background: AppColors.chart-neutral;
                }
                scroll-touch := TouchArea {
                    property <length> saved-mouse-y;
                    property <length> saved-viewport-y;
                    x: -5px;
                    width: parent.width + 10px;
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            self.saved-mouse-y = self.mouse-y;
                            self.saved-viewport-y = detail-body.viewport-y;
                        }
                    }
                    moved => {
                        if self.pressed {
                            detail-body.viewport-y = max(
                                detail-body.height - detail-body.viewport-height,
                                min(
                                    0px,
                                    self.saved-viewport-y - (self.mouse-y - self.saved-mouse-y)
                                        * (detail-body.viewport-height - detail-body.height)
                                        / (parent.height - scroll-thumb.height)
                                )
                            );
                        }
                    }
                }
            }
        }
    }
    Timer {
        interval: 2s;
        running: root.showing-live-memory;
        triggered => { root.refresh-runtime-memory(root.kind); }
    }
    init => { modal-focus.focus(); }
    changed kind => { detail-body.viewport-y = 0px; }
    changed visible => { if root.visible { detail-body.viewport-y = 0px; modal-focus.focus(); } }
}

export component LocalModelDownloadFailureDialog inherits Rectangle {
    in property <string> detail;
    in property <bool> insufficient-space: false;
    callback retry();
    callback later();
    callback manage-space();

    failure-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.later(); return accept; }
            return reject;
        }

        failure-shell := ModalShell {
            width: parent.width;
            height: parent.height;
            size: ModalSize.compact;
            panel-height-override: root.insufficient-space ? 264px : 220px;
            close-requested => { root.later(); }

            Rectangle {
                x: 24px;
                y: 22px;
                width: 38px;
                height: 38px;
                border-radius: 8px;
                background: AppColors.danger-soft;
                Image {
                    x: 9px;
                    y: 9px;
                    width: 20px;
                    height: 20px;
                    source: @image-url("../../icons/lucide/circle-alert.svg");
                    colorize: AppColors.danger;
                }
            }
            Text {
                x: 76px;
                y: 20px;
                width: failure-shell.panel-width - 136px;
                text: @tr("models.asr.local.download-failure.title" => "Model download failed");
                color: AppColors.ink;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                x: 24px;
                y: 78px;
                width: failure-shell.panel-width - 48px;
                height: 62px;
                text: root.detail;
                color: AppColors.text-muted;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
            }
            if root.insufficient-space: LocalModelActionButton {
                x: 24px;
                y: failure-shell.panel-height - 98px;
                label: @tr("models.asr.local.download-failure.manage-space" => "Manage space");
                activated => { root.manage-space(); }
            }
            later-button := LocalModelActionButton {
                x: retry-button.x - self.width - 12px;
                y: failure-shell.panel-height - 54px;
                label: @tr("models.asr.local.download-failure.later" => "Later");
                activated => { root.later(); }
            }
            retry-button := LocalModelActionButton {
                x: failure-shell.panel-width - self.width - 24px;
                y: failure-shell.panel-height - 54px;
                label: @tr("models.asr.local.download-failure.retry" => "Continue download");
                primary: true;
                activated => { root.retry(); }
            }
        }
    }
    init => { failure-focus.focus(); }
}
