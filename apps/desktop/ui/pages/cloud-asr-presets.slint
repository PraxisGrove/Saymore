import { AppColors } from "../color-system.slint";
import { CloudAsrService } from "../components.slint";

component PresetButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback activated();
    height: 36px;
    border-radius: 7px;
    border-width: 1px;
    border-color: button-focus.has-focus ? AppColors.brand-strong : AppColors.border;
    background: button-touch.has-hover && root.enabled ? AppColors.selected : AppColors.surface;
    opacity: root.enabled ? 1 : 0.55;
    Text {
        text: root.label;
        color: AppColors.text;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    button-focus := FocusScope {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.label;
        accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.activated(); } }
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    button-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { button-focus.focus(); root.activated(); }
    }
}

export component CloudAsrPresets inherits Rectangle {
    in property <bool> testing: false;
    callback configure(CloudAsrService);
    height: helper.y + helper.preferred-height + 50px;
    background: transparent;
    Text {
        text: @tr("models.asr.presets.title" => "Quick cloud setup");
        color: AppColors.ink;
        font-size: 13px;
        font-weight: 650;
    }
    helper := Text {
        y: 23px;
        width: parent.width;
        text: @tr("models.asr.presets.detail" => "Fill a preset, enter your API key, then test and save. Saving replaces the compatible API configuration.");
        color: AppColors.text-muted;
        font-size: 11px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        y: helper.y + helper.preferred-height + 10px;
        width: parent.width;
        height: 36px;
        spacing: 12px;
        PresetButton { label: "OpenAI"; enabled: !root.testing; activated => { root.configure(CloudAsrService.openai); } }
        PresetButton { label: "Groq"; enabled: !root.testing; activated => { root.configure(CloudAsrService.groq); } }
        PresetButton { label: "Mistral · Voxtral"; enabled: !root.testing; activated => { root.configure(CloudAsrService.mistral); } }
    }
}
