import { AppColors } from "../color-system.slint";

export enum ProviderStatusTone {
    neutral,
    active,
    error,
}

export component ProviderStatusBadge inherits Rectangle {
    in property <string> label;
    in property <ProviderStatusTone> tone: ProviderStatusTone.neutral;
    in property <bool> current: false;
    in property <bool> available: false;

    width: max(56px, status-label.preferred-width + (root.current || root.available ? 27px : 8px));
    height: 22px;
    border-radius: 6px;
    background: root.current ? AppColors.success
        : root.available ? AppColors.success-soft
        : root.tone == ProviderStatusTone.active ? AppColors.success-soft
        : root.tone == ProviderStatusTone.error ? AppColors.danger-soft
        : AppColors.surface-muted;

    if root.current || root.available: Rectangle {
        x: root.current ? 11px : 12px;
        y: root.current ? 7px : 9px;
        width: root.current ? 8px : 5px;
        height: root.current ? 8px : 5px;
        border-radius: root.available ? 3px : 0px;
        background: root.available ? AppColors.success : transparent;
        if root.current: Image {
            width: 8px;
            height: 8px;
            source: @image-url("../../icons/lucide/check.svg");
            colorize: AppColors.on-brand;
        }
    }
    status-label := Text {
        x: root.current || root.available ? 22px : 4px;
        width: root.current || root.available ? parent.width - 25px : parent.width - 8px;
        text: root.label;
        color: root.current ? AppColors.on-brand
            : root.available ? AppColors.success
            : root.tone == ProviderStatusTone.active ? AppColors.success
            : root.tone == ProviderStatusTone.error ? AppColors.danger
            : AppColors.text-muted;
        font-size: 11px;
        font-weight: root.current ? 700 : 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AsrProviderCard inherits Rectangle {
    in property <image> logo;
    in property <length> logo-size: 44px;
    in property <bool> colorize-logo: false;
    in property <image> summary-icon;
    in property <string> source-type;
    in property <string> provider-name;
    in property <string> summary;
    in property <string> status;
    in property <ProviderStatusTone> status-tone: ProviderStatusTone.neutral;
    in property <bool> recommended: false;
    in property <bool> selected: false;
    in property <bool> available: false;
    in property <bool> enabled: true;
    callback activated();

    private property <length> provider-row-y: 36px;
    private property <length> provider-row-height: 44px;
    height: 108px;
    border-radius: 10px;
    background: !root.enabled ? AppColors.surface
        : card-touch.pressed ? AppColors.selected
        : card-focus.has-focus ? AppColors.selected
        : card-touch.has-hover ? AppColors.surface-subtle
        : root.selected ? AppColors.brand-soft : AppColors.surface;
    animate background { duration: 140ms; easing: ease-out; }

    Text {
        x: 16px;
        y: 6px;
        width: parent.width - 48px;
        height: 20px;
        text: root.source-type;
        color: root.selected ? AppColors.brand-strong : AppColors.text-muted;
        font-size: 11px;
        font-weight: 650;
        vertical-alignment: center;
        overflow: elide;
    }

    if !root.colorize-logo: Image {
        x: 16px + (root.provider-row-height - root.logo-size) / 2;
        y: root.provider-row-y + (root.provider-row-height - root.logo-size) / 2;
        width: root.logo-size;
        height: root.logo-size;
        source: root.logo;
        image-fit: contain;
        image-rendering: smooth;
    }
    if root.colorize-logo: Image {
        x: 16px + (root.provider-row-height - root.logo-size) / 2;
        y: root.provider-row-y + (root.provider-row-height - root.logo-size) / 2;
        width: root.logo-size;
        height: root.logo-size;
        source: root.logo;
        colorize: AppColors.ink;
        image-fit: contain;
        image-rendering: smooth;
    }

    provider-copy := Rectangle {
        x: 74px;
        y: 28px;
        width: parent.width - 122px;
        height: root.provider-row-height;
        background: transparent;

        provider-name-label := Text {
            x: 0px;
            y: 0px;
            width: parent.width - (root.recommended ? 14px : 0px);
            height: 20px;
            text: root.provider-name;
            color: root.enabled ? AppColors.ink : AppColors.text;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.recommended: Image {
            x: min(provider-name-label.preferred-width + 4px, parent.width - 10px);
            y: 5px;
            width: 10px;
            height: 10px;
            source: @image-url("../../icons/phosphor/star-fill.svg");
            colorize: AppColors.brand;
            image-fit: contain;
            image-rendering: smooth;
        }
        Rectangle {
            x: 0px;
            y: 26px;
            width: parent.width;
            height: 18px;
            background: transparent;

            Image {
                x: 0px;
                y: 2px;
                width: 14px;
                height: 14px;
                source: root.summary-icon;
                colorize: AppColors.text-muted;
                image-fit: contain;
            }
            Text {
                x: 20px;
                width: parent.width - 20px;
                height: parent.height;
                text: root.summary;
                color: AppColors.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    ProviderStatusBadge {
        x: 74px;
        y: 78px;
        label: root.status;
        tone: root.status-tone;
        current: root.selected;
        available: root.available && !root.selected;
    }

    Image {
        x: parent.width - 34px;
        y: 39px;
        width: 18px;
        height: 18px;
        source: @image-url("../../icons/lucide/chevron-right.svg");
        colorize: root.enabled ? AppColors.text-muted : AppColors.chart-neutral;
    }

    card-focus := FocusScope {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.provider-name;
        accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.activated(); } }
        key-pressed(event) => {
            if root.enabled && (event.text == "\n" || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    card-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            card-focus.focus();
            root.activated();
        }
    }
}
