import { AppColors } from "../color-system.slint";
export enum LocalRecognitionMode { non-streaming, streaming }

export component RecognitionModeControl inherits Rectangle {
    in property <LocalRecognitionMode> mode: LocalRecognitionMode.non-streaming;
    callback changed(LocalRecognitionMode);
    height: 26px;
    for label[index] in [@tr("models.asr.mode.non-streaming" => "Non-streaming"), @tr("models.asr.mode.streaming" => "Streaming")]: Rectangle {
        x: index * (parent.width / 2);
        width: parent.width / 2 - 3px;
        height: parent.height;
        private property <LocalRecognitionMode> value: index == 0 ? LocalRecognitionMode.non-streaming : LocalRecognitionMode.streaming;
        background: root.mode == self.value ? AppColors.selected : AppColors.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.mode == self.value ? AppColors.brand : AppColors.border;
        Text {
            text: label;
            font-size: 11px;
            color: AppColors.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            accessible-role: button;
            accessible-label: label;
            clicked => { root.changed(parent.value); }
        }
    }
}
