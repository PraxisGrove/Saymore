import { ScrollView } from "std-widgets.slint";
import { AppColors } from "../color-system.slint";

component UsageMetric inherits Rectangle {
    in property <string> value;
    in property <string> unit;
    in property <string> label;
    in property <bool> show-unit: true;
    in property <int> placement: 1;
    private property <length> value-row-width: metric-value.preferred-width + (root.show-unit ? 8px + metric-unit.preferred-width : 0px);
    background: transparent;

    metric-value := Text {
        x: root.placement == 0 ? 0px : root.placement == 2 ? root.width - root.value-row-width : (root.width - root.value-row-width) / 2;
        y: 4px;
        text: root.value;
        color: AppColors.ink;
        font-size: 25px;
        font-weight: 700;
    }
    metric-unit := Text {
        x: metric-value.x + metric-value.preferred-width + 8px;
        y: 20px;
        text: root.show-unit ? root.unit : "";
        color: AppColors.text-muted;
        font-size: 9px;
    }
    metric-label := Text {
        x: root.placement == 0 ? 0px : root.placement == 2 ? root.width - self.preferred-width : (root.width - self.preferred-width) / 2;
        y: 42px;
        text: root.label;
        color: AppColors.text-muted;
        font-size: 9px;
    }
}

component DayBar inherits Rectangle {
    in property <float> level;
    in property <string> label;
    in property <bool> highlighted;
    in property <string> details;
    callback hovered(bool);
    private property <bool> hover-active: day-touch.has-hover;
    background: transparent;
    accessible-role: text;
    accessible-label: root.details;

    Rectangle {
        x: (parent.width - 24px) / 2;
        y: parent.height - self.height - 18px;
        width: 24px;
        height: root.level <= 0 ? 0px : max(4px, (parent.height - 28px) * root.level);
        border-radius: 6px;
        background: root.highlighted ? AppColors.brand : AppColors.chart-neutral;
    }
    Text { y: parent.height - 12px; width: parent.width; height: 12px; text: root.label; color: root.highlighted ? AppColors.brand : AppColors.text-muted; font-size: 9px; font-weight: root.highlighted ? 600 : 400; horizontal-alignment: center; vertical-alignment: top; }
    day-touch := TouchArea { }
    changed hover-active => { root.hovered(root.hover-active); }
}

component VoiceMark inherits Rectangle {
    background: transparent;
    Rectangle { x: 0px; y: 15px; width: 4px; height: 8px; border-radius: 2px; background: AppColors.brand; }
    Rectangle { x: 7px; y: 10px; width: 4px; height: 18px; border-radius: 2px; background: AppColors.brand; }
    Rectangle { x: 14px; y: 6px; width: 4px; height: 26px; border-radius: 2px; background: AppColors.brand; }
    Rectangle { x: 21px; y: 11px; width: 4px; height: 16px; border-radius: 2px; background: AppColors.brand; }
    Rectangle { x: 28px; y: 14px; width: 4px; height: 10px; border-radius: 2px; background: AppColors.brand; }
}

component SummaryCard inherits Rectangle {
    out property <length> content-inset: 20px;
    in property <string> title;
    in property <string> status-label;
    in property <color> status-ink;
    in property <color> status-background;
    in property <bool> show-voice-mark;
    in property <bool> show-status-dot;
    height: 196px;
    border-radius: 12px;
    background: AppColors.surface;

    HorizontalLayout {
        x: root.content-inset; y: 16px; width: root.width - 2 * self.x; height: 40px;
        spacing: 12px;
        cross-axis-alignment: center;
        if root.show-voice-mark: VoiceMark { width: 32px; height: 38px; }
        Text {
            text: root.title;
            min-width: 0px; height: parent.height; horizontal-stretch: 1;
            color: AppColors.ink; font-size: 14px; font-weight: 700;
            wrap: word-wrap; vertical-alignment: center;
        }
        Rectangle {
            width: 74px; height: 26px; border-radius: 7px;
            background: root.status-background;
            HorizontalLayout {
                alignment: center; cross-axis-alignment: center; spacing: 5px;
                if root.show-status-dot: Rectangle {
                    width: 7px; height: 7px; border-radius: 4px; background: root.status-ink;
                }
                Text { text: root.status-label; color: root.status-ink; font-size: 10px; font-weight: 650; }
            }
        }
    }
    @children
}

component ShortcutKeycap inherits Rectangle {
    in property <string> label;
    width: 158px;
    height: 34px;
    border-radius: 8px;
    background: AppColors.surface-subtle;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: AppColors.shadow;
    Text { text: root.label; color: AppColors.text; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
}

component StatusNode inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> ready;
    private property <length> link-gap: 3px;
    callback activated();

    min-width: status-icon.width + root.link-gap + link.width;
    preferred-width: max(status-icon.width, caption.preferred-width) + root.link-gap + link.width;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    status-icon := Rectangle {
        x: (caption.width - self.width) / 2;
        y: 2px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: root.ready ? AppColors.success-soft : AppColors.surface-subtle;
        Image { x: 8px; y: 8px; width: 14px; height: 14px; source: root.icon; colorize: root.ready ? AppColors.success : AppColors.text-muted; }
    }
    caption := Text {
        x: 0px; width: root.width - root.link-gap - link.width;
        height: 32px; y: root.height - self.height;
        text: root.label; color: AppColors.text; font-size: 10px; font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    link := Image {
        width: 9px; height: 9px;
        x: caption.x + caption.width + root.link-gap;
        y: caption.y + (caption.height - self.height) / 2;
        source: @image-url("../../icons/lucide/arrow-up-right.svg"); colorize: AppColors.text-muted;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component HomePage inherits Rectangle {
    in property <bool> authorized;
    in property <string> authorization-status;
    in property <bool> microphone-authorized;
    in property <string> microphone-status;
    in property <bool> asr-configured;
    in property <bool> asr-home-available;
    in property <bool> asr-config-error;
    in property <bool> asr-pending-test;
    in property <string> asr-config-status;
    in property <string> shortcut-label: "Right Command";
    in property <[string]> shortcut-labels;
    in property <bool> shortcut-enabled: true;
    in property <string> usage-total-minutes: "0";
    in property <string> usage-total-characters: "0";
    in property <string> usage-average-speed: "0";
    in property <[float]> usage-trend;
    in property <[string]> usage-day-labels;
    in property <[string]> usage-day-dates;
    in property <[string]> usage-daily-minutes;
    in property <[string]> usage-daily-characters;
    in property <[string]> usage-daily-speeds;
    in property <int> usage-highlighted-day: -1;
    in property <bool> usage-loading: false;
    in property <bool> usage-error: false;
    callback open-model-settings();
    callback open-shortcut-settings();
    callback open-microphone-settings();
    callback open-accessibility-settings();
    callback refresh-usage();

    private property <bool> microphone-issue: !root.microphone-authorized;
    private property <bool> model-issue: !root.asr-home-available;
    private property <bool> accessibility-issue: !root.authorized;
    private property <bool> healthy: !root.microphone-issue && !root.model-issue && !root.accessibility-issue;
    private property <length> card-gap: 16px;
    private property <length> card-body-y: 100px;
    private property <length> card-body-height: 72px;
    private property <length> shortcut-card-width: root.width >= 650px ? 326px : (root.width - card-gap) / 2;
    private property <length> configuration-x: shortcut-card-width + card-gap;
    private property <string> primary-shortcut: root.shortcut-labels.length > 0 ? root.shortcut-labels[0] : root.shortcut-label;
    private property <int> hovered-usage-day: -1;
    private property <bool> showing-daily-usage: root.hovered-usage-day >= 0 && !root.usage-loading && !root.usage-error;

    background: transparent;
    page-scroll := ScrollView {
        width: root.width;
        height: root.height;
        viewport-width: self.width;
        viewport-height: max(self.height, 616px);
        Rectangle {
            width: page-scroll.viewport-width;
            height: page-scroll.viewport-height;
            Text { x: 0px; y: 43px; width: parent.width; text: @tr("home.headline" => "Speak your mind, hands-free"); color: AppColors.ink; font-size: 27px; font-weight: 700; overflow: elide; }

            SummaryCard {
                x: 0px; y: 100px; width: root.shortcut-card-width;
                title: @tr("home.shortcut.title" => "Voice input shortcut");
                show-voice-mark: true;
                status-label: root.shortcut-enabled ? @tr("common.enabled" => "Enabled") : @tr("common.disabled" => "Disabled");
                status-ink: root.shortcut-enabled ? AppColors.brand-strong : AppColors.danger;
                status-background: root.shortcut-enabled ? AppColors.brand-soft : AppColors.danger-soft;
                accessible-role: button; accessible-label: self.title; accessible-action-default => { root.open-shortcut-settings(); }

                if root.shortcut-enabled: ShortcutKeycap { x: 20px; y: root.card-body-y; label: root.primary-shortcut; }
                if root.shortcut-labels.length > 1: Rectangle {
                    x: 186px; y: root.card-body-y + 5px; width: 34px; height: 24px; border-radius: 7px; background: AppColors.brand-soft;
                    Text { text: "+" + (root.shortcut-labels.length - 1); color: AppColors.brand-strong; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                HorizontalLayout {
                    x: 20px; width: parent.width - 40px; height: 32px;
                    y: root.card-body-y + root.card-body-height - self.height;
                    spacing: 6px; cross-axis-alignment: center;
                    Text { text: @tr("home.shortcut.toggle-hint" => "Press once to start, then again to finish"); min-width: 0px; horizontal-stretch: 1; color: AppColors.text-muted; font-size: 10px; wrap: word-wrap; }
                    Text { text: @tr("common.edit" => "Edit"); color: AppColors.text; font-size: 10px; font-weight: 600; }
                    Image { width: 11px; height: 11px; source: @image-url("../../icons/lucide/chevron-right.svg"); colorize: AppColors.text-muted; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.open-shortcut-settings(); } }
            }

            SummaryCard {
                x: root.configuration-x; y: 100px; width: parent.width - root.configuration-x - 1px;
                title: @tr("home.configuration-status.title" => "Configuration status");
                status-label: root.healthy ? @tr("home.health.all-good" => "All good") : @tr("home.health.pending" => "Pending");
                status-ink: root.healthy ? AppColors.success : AppColors.text-muted;
                status-background: root.healthy ? AppColors.success-soft : AppColors.surface-subtle;
                show-status-dot: true;

                Text { x: parent.content-inset; y: 54px; text: root.healthy ? @tr("home.health.summary-ready" => "Voice pipeline is ready") : @tr("home.health.summary-incomplete" => "Finish the remaining setup"); color: AppColors.text-muted; font-size: 10px; }
                HorizontalLayout {
                    x: parent.content-inset; y: root.card-body-y; width: parent.width - 2 * self.x; height: root.card-body-height;
                    alignment: space-between; spacing: 8px;
                    StatusNode { icon: @image-url("../../icons/lucide/sparkles.svg"); label: @tr("home.health.model" => "Model service"); ready: root.asr-home-available; activated => { root.open-model-settings(); } }
                    StatusNode { icon: @image-url("../../icons/lucide/audio-lines.svg"); label: @tr("home.health.microphone" => "Microphone"); ready: root.microphone-authorized; activated => { root.open-microphone-settings(); } }
                    StatusNode { icon: @image-url("../../icons/lucide/check.svg"); label: @tr("home.health.delivery" => "Text delivery"); ready: root.authorized; activated => { root.open-accessibility-settings(); } }
                }
            }

            usage-card := Rectangle {
                x: 0px; y: 313px; width: parent.width - 1px; height: max(300px, parent.height - 316px); border-radius: 12px; background: AppColors.surface;
                Text { x: 20px; y: 18px; text: @tr("home.usage.title" => "Usage overview"); color: AppColors.ink; font-size: 14px; font-weight: 650; }
                Text { x: 20px; y: 46px; text: root.usage-loading ? @tr("home.usage.loading" => "Loading") : root.usage-error ? @tr("home.usage.failed" => "Could not load") : root.showing-daily-usage ? root.usage-day-labels[root.hovered-usage-day] + " · " + root.usage-day-dates[root.hovered-usage-day] : @tr("home.usage.totals" => "All-time totals"); color: root.showing-daily-usage ? AppColors.brand : AppColors.text-muted; font-size: 10px; font-weight: root.showing-daily-usage ? 600 : 500; }
                private property <length> metric-width: (self.width - 40px) / 3;
                UsageMetric { x: 20px; y: 68px; width: parent.metric-width; height: 68px; value: root.usage-loading ? "•••" : root.usage-error ? "—" : root.showing-daily-usage ? root.usage-daily-minutes[root.hovered-usage-day] : root.usage-total-minutes; unit: @tr("home.usage.minutes.unit" => "min"); show-unit: !root.usage-loading && !root.usage-error; label: @tr("home.usage.dictation-total" => "Voice input time"); placement: 0; }
                UsageMetric { x: 20px + parent.metric-width; y: 68px; width: parent.metric-width; height: 68px; value: root.usage-loading ? "•••" : root.usage-error ? "—" : root.showing-daily-usage ? root.usage-daily-characters[root.hovered-usage-day] : root.usage-total-characters; unit: @tr("home.usage.characters.unit" => "characters"); show-unit: !root.usage-loading && !root.usage-error; label: @tr("home.usage.characters-total" => "Characters entered"); }
                UsageMetric { x: 20px + parent.metric-width * 2; y: 68px; width: parent.metric-width; height: 68px; value: root.usage-loading ? "•••" : root.usage-error ? "—" : root.showing-daily-usage ? root.usage-daily-speeds[root.hovered-usage-day] : root.usage-average-speed; unit: @tr("home.usage.speed.unit" => "chars/min"); show-unit: !root.usage-loading && !root.usage-error; label: @tr("home.usage.average-speed" => "Average speed"); placement: 2; }
                if root.usage-error: Rectangle {
                    x: parent.width - 104px; y: 14px; width: 84px; height: 28px; background: transparent;
                    Text { text: @tr("common.reload" => "Reload ↗"); color: AppColors.brand-strong; font-size: 10px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.refresh-usage(); } }
                }
                Text { x: 20px; y: 160px; text: @tr("home.usage.seven-day-trend" => "Last 7 days"); color: AppColors.text-muted; font-size: 10px; font-weight: 600; }
                HorizontalLayout {
                    x: 40px; y: 192px; width: parent.width - 80px; height: max(80px, parent.height - 210px); spacing: 0px; alignment: space-between;
                    for label[index] in root.usage-day-labels: DayBar {
                        width: 48px;
                        level: root.usage-trend[index];
                        label: label;
                        highlighted: root.hovered-usage-day >= 0 ? index == root.hovered-usage-day : index == root.usage-highlighted-day;
                        details: label + " " + root.usage-day-dates[index] + ", " + root.usage-daily-minutes[index] + " " + @tr("home.usage.minutes.unit" => "min") + ", " + root.usage-daily-characters[index] + " " + @tr("home.usage.characters.unit" => "characters") + ", " + root.usage-daily-speeds[index] + " " + @tr("home.usage.speed.unit" => "chars/min");
                        hovered(hovered) => { root.hovered-usage-day = hovered ? index : -1; }
                    }
                }
            }
        }
    }
}
